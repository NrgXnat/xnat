.java-version
.gradle/
# Use anchored patterns so 'build/' doesn't match package-name dirs like
# xnat-data-builder/src/main/groovy/org/nrg/xnat/build/ (which is source code).
/build/
*/build/
buildSrc/build/
buildSrc/.gradle/
**/target/
*.log

# IDE
.idea/
*.iml
out/
.DS_Store

# Eclipse / jdtls / Buildship (Claude Code starts jdtls in background)
.project
.classpath
.settings/
bin/

# OS
.DS_Store
Thumbs.db
.claude/
# Staged WAR for the local Tomcat 9 compose stack (build artifact)
docker-context/
# Golden-master baselines are local, data-dependent artifacts (regenerated by
# docker/golden-capture.sh update against the build-known-state.sh fixture)
docs/goldens/
# Python bytecode from docker/ + docs/tools/ scripts
__pycache__/
docs/goldens-develop/

# init-xnat.sh local secrets/overrides (SMTP creds) — never commit
docker/init-xnat.local.sh
docker/*.local.sh

# Staged plugin jars (regenerated by docker/stage-plugins.sh from docker/plugins.manifest)
docker/plugins/

# local email-config secrets
docker/configure-email.local.sh
