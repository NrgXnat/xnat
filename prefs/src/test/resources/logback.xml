<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d %5p %40.40c:%4L - %m%n</pattern>
        </encoder>
    </appender>
    <appender name="preferences" class="ch.qos.logback.core.FileAppender">
        <file>target/preferences-test.log</file>
        <append>false</append>
        <encoder>
            <pattern>%d [%t] %-5p %class.%method:%line - %m%n</pattern>
        </encoder>
    </appender>
    <root level="WARN">
        <appender-ref ref="console"/>
        <appender-ref ref="preferences"/>
    </root>
    <logger name="org.nrg.prefs" additivity="false" level="INFO">
        <appender-ref ref="console"/>
        <appender-ref ref="preferences"/>
    </logger>
</configuration>