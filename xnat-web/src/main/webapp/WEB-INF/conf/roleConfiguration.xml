<?xml version="1.0" encoding="UTF-8"?>
<!--
  DRAFT — Turbine 5.1 YAAFI role configuration for XNAT (Phase 0b).
  NOT wired into the build yet. Destination when enabled: WEB-INF/conf/roleConfiguration.xml
  Wire via TurbineResources.properties:
    services.AvalonComponentService.classname=org.apache.turbine.services.avaloncomponent.TurbineYaafiComponentService
    services.AvalonComponentService.componentRoles=/WEB-INF/conf/roleConfiguration.xml

  Maps each Fulcrum role interface -> default implementation. These are the 5 services
  that left Turbine core in the 4.0 rewrite (Factory, Pool, GlobalCache, Crypto, Upload)
  PLUS the Fulcrum ParserService, which in Turbine 4+ replaces the old
  DefaultParameterParser/DefaultCookieParser that RunDataService used in 2.3.3.

  Provenance: role names/default-classes taken verbatim from the Apache Turbine
  "Migrate 2.3.3 -> 4.0" wiki and the individual Fulcrum component docs.
  VERIFY exact FQCNs against the Fulcrum versions Turbine 5.1 actually resolves
  (e.g. some impls live in an `.impl` subpackage) — the Appendix C boot test will
  fail-fast on any mismatch.
-->
<role-list>
    <role name="org.apache.fulcrum.factory.FactoryService"
          shorthand="factory"
          default-class="org.apache.fulcrum.factory.DefaultFactoryService"/>

    <role name="org.apache.fulcrum.pool.PoolService"
          shorthand="pool"
          default-class="org.apache.fulcrum.pool.DefaultPoolService"/>

    <role name="org.apache.fulcrum.cache.GlobalCacheService"
          shorthand="cache"
          default-class="org.apache.fulcrum.cache.impl.DefaultGlobalCacheService"/>

    <!-- Trim candidate: CryptoService is only reachable via the (vestigial) Turbine
         SecurityService. Drop this role if the passive-security stub does not need it. -->
    <role name="org.apache.fulcrum.crypto.CryptoService"
          shorthand="crypto"
          default-class="org.apache.fulcrum.crypto.DefaultCryptoService"/>

    <!-- Required by RunDataService in 4.0+ for parameter/cookie parsing. -->
    <role name="org.apache.fulcrum.parser.ParserService"
          shorthand="parser"
          default-class="org.apache.fulcrum.parser.DefaultParserService"/>

    <!-- Trim candidate: XNAT only uses Turbine upload in UploadBatch.java; DICOM/file
         uploads go through Restlet/Spring multipart instead. Keep only if UploadBatch
         (or parser automaticUpload) still needs it. -->
    <role name="org.apache.fulcrum.upload.UploadService"
          shorthand="upload"
          default-class="org.apache.fulcrum.upload.DefaultUploadService"/>

    <!-- ===================================================================================
         Fulcrum security (Turbine 4.0+). Turbine 5.1's PullService.populateContext() looks up a
         TurbineUserManager (role org.apache.fulcrum.security.UserManager) on EVERY screen render to
         test isAnonymousUser(); without it, every /app page throws "unknown service ...UserManager".
         XNAT authenticates via Spring Security + XDAT — Turbine security is vestigial (it ran the
         no-op PassiveUserManager) — so wire the in-memory Fulcrum turbine-model stack: a working but
         empty security realm. Managers register under their BASE role FQNs (the turbine-model
         interfaces inherit ROLE from these); impls are the memory turbine-model classes.
         Requires fulcrum-security-memory on the classpath. -->
    <role name="org.apache.fulcrum.security.SecurityService"
          shorthand="securityService"
          default-class="org.apache.fulcrum.security.BaseSecurityService"/>
    <role name="org.apache.fulcrum.security.UserManager"
          shorthand="userManager"
          default-class="org.apache.fulcrum.security.memory.turbine.MemoryTurbineUserManagerImpl"/>
    <role name="org.apache.fulcrum.security.GroupManager"
          shorthand="groupManager"
          default-class="org.apache.fulcrum.security.memory.MemoryGroupManagerImpl"/>
    <role name="org.apache.fulcrum.security.RoleManager"
          shorthand="roleManager"
          default-class="org.apache.fulcrum.security.memory.MemoryRoleManagerImpl"/>
    <role name="org.apache.fulcrum.security.PermissionManager"
          shorthand="permissionManager"
          default-class="org.apache.fulcrum.security.memory.MemoryPermissionManagerImpl"/>
    <role name="org.apache.fulcrum.security.ModelManager"
          shorthand="modelManager"
          default-class="org.apache.fulcrum.security.memory.turbine.MemoryTurbineModelManagerImpl"/>
    <role name="org.apache.fulcrum.security.model.ACLFactory"
          shorthand="aclFactory"
          default-class="org.apache.fulcrum.security.model.turbine.TurbineACLFactory"/>
</role-list>
