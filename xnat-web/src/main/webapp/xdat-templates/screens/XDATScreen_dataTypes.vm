<script type="text/javascript">

    // Initialize tabs
    var dataTypesTabView = new YAHOO.widget.TabView('data-types-tabs');

    jq('a.data-type-link').click(function(e){
        e.preventDefault();
        XNAT.app.adminPopupDialog(this.href);
        //popupCentered(this.href,' ',960,720,3)
    });

    function updateDatatypePreview() {
        var dialog = jq('.xnat-dialog:visible');
        var name = dialog.find('input[name="name"]').val().trim();
        var prefix = dialog.find('input[name="prefix"]').val().trim();
        var complexTypeInput = dialog.find('input[name="complexType"]').val().trim();
        var previewElement = dialog.find('#preview-element-name');
        var previewComplex = dialog.find('#preview-complex-type');

        if (!name) {
            previewElement.text('--');
            previewComplex.text('--');
            dialog.find('#name-warning').hide();
            return;
        }

        var elementName;
        var complexType;

        // set backend name and complex type to match, minus the "Data" suffix on complexType
        if (complexTypeInput) {
            // User explicitly set the complexType
            complexType = complexTypeInput;
            // Derive element name by stripping trailing "Data" (case-sensitive) if present
            if (complexType.length > 4 && complexType.substring(complexType.length - 4) === 'Data') {
                elementName = complexType.substring(0, complexType.length - 4);
            } else {
                elementName = complexType;
            }
            // Capitalize first letter for element name
            elementName = elementName.substring(0, 1).toUpperCase() + elementName.substring(1);
        } else {
            // Auto-derive from the Name field, mirroring CreateDataTypeCallable logic
            if (name.length > 4 && name.substring(name.length - 4) === 'Data') {
                // User already included "Data" suffix — use as-is for complexType
                complexType = name.substring(0, 1).toLowerCase() + name.substring(1);
                elementName = name.substring(0, name.length - 4);
                elementName = elementName.substring(0, 1).toUpperCase() + elementName.substring(1);
            } else {
                // Append "Data" to form complexType
                complexType = name.substring(0, 1).toLowerCase() + name.substring(1) + 'Data';
                elementName = name.substring(0, 1).toUpperCase() + name.substring(1);
            }
        }

        var prefixDisplay = prefix || 'x{N}';
        previewElement.text(elementName);
        previewComplex.text(prefixDisplay + ':' + complexType);

        // Warn on overly generic names
        var genericNames = ['test', 'data', 'session', 'experiment', 'scan', 'subject',
                            'project', 'image', 'assessment', 'assessor', 'sample', 'type',
                            'custom', 'new', 'temp', 'demo', 'example', 'default'];
        var baseName = name.replace(/Data$/i, '').toLowerCase();
        var warning = dialog.find('#name-warning');
        if (genericNames.indexOf(baseName) !== -1) {
            warning.show();
        } else {
            warning.hide();
        }
    }

    function toggleAdvancedSettings() {
        var dialog = jq('.xnat-dialog:visible');
        var section = dialog.find('#advanced-settings-section');
        var icon = dialog.find('#advanced-settings-icon');
        var dialogElement = dialog.closest('.ui-dialog');

        if (section.is(':visible')) {
            section.hide();
            icon.html('+');
            dialogElement.removeClass('expanded');
        } else {
            section.show();
            icon.html('&ndash;');
            dialogElement.addClass('expanded');
        }
    }

    function submitCreateDataType() {
        var dialog = jq('.xnat-dialog:visible');
        var name = dialog.find('input[name="name"]').val().trim();
        var extendsValue = dialog.find('select[name="extends"]').val();
        var singular = dialog.find('input[name="singular"]').val().trim();
        var plural = dialog.find('input[name="plural"]').val().trim();
        var prefix = dialog.find('input[name="prefix"]').val().trim();
        var complexType = dialog.find('input[name="complexType"]').val().trim();

        var knownPrefixes = [],
            knownElements = [],
            knownNames = [],
            restrictedPrefixes = ['cat','prov','icr','scr','wrk','xnat','xnat_a'];
        XNAT.data.xftElements.forEach(function(el){
            var thisPrefix = el['ELEMENT_NAME'].split(':')[0];
            var thisElement = el['ELEMENT_NAME'].split(':')[1]
            var thisName = thisElement.replace('Data','');
            if (knownPrefixes.indexOf(thisPrefix <0 ))  knownPrefixes.push(thisPrefix);
            if (knownElements.indexOf(thisElement <0 ))  knownElements.push(thisElement);
            if (knownNames.indexOf(thisName <0 ))  knownNames.push(thisName);
        });

        if (!name || !extendsValue || !singular || !plural) {
            alert('All fields are required');
            return;
        }

        if (knownNames.indexOf(name) >= 0) {
            alert('This backend name is already being used in another datatype definition');
            return;
        }

        // Validate advanced settings if provided
        if (prefix) {
            if (prefix.length < 2 || prefix.length > 6 || !/^[A-Za-z0-9]+$/.test(prefix)) {
                alert('Prefix must be 2-6 alphanumeric characters');
                return;
            }

            // if (knownPrefixes.indexOf(prefix) >= 0) {
            //    alert('This prefix is already being used in another datatype definition');
            //    return;
            // }

            if (restrictedPrefixes.indexOf(prefix) >= 0) {
                alert('This prefix is reserved by the XNAT application and cannot be used here');
                return;
            }
        }

        if (complexType) {
            if (complexType.length < 4 || complexType.length > 24 || !/^[A-Za-z0-9_]+$/.test(complexType)) {
                alert('Complex type must be 4-24 characters (letters, numbers, underscores only)');
                return;
            }

            if (knownElements.indexOf(complexType) >= 0) {
                alert('This complexType value is already being used in another datatype definition');
                return;
            }
        }

        if (!confirm('WARNING: Data Types in XNAT are generally permanent and can be difficult (though not impossible) to remove. This operation will also make structural modifications to your database and may take several seconds to complete.\n\nDo you want to continue?')) {
            return;
        }

        XNAT.dialog.loading.open();

        var url = '/data/search/elements?task=create&name=' +
                 encodeURIComponent(name) + '&extends=' +
                 encodeURIComponent(extendsValue) + '&singular=' +
                 encodeURIComponent(singular) + '&plural=' +
                 encodeURIComponent(plural);

        // Add optional advanced settings if provided
        if (prefix) {
            url += '&prefix=' + encodeURIComponent(prefix);
        }
        if (complexType) {
            url += '&complexType=' + encodeURIComponent(complexType);
        }

        url = XNAT.url.csrfUrl(url);

        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        }).then(function(response) {
            XNAT.dialog.loading.close();
            if (response.ok) {
                XNAT.dialog.closeAll();
                // Parse the response to get the complexType
                response.json().then(function(data) {
                    // Store the data type info for later dialogs
                    window.newDataTypeInfo = {
                        name: name,
                        extendsValue: extendsValue,
                        singular: singular,
                        plural: plural,
                        complexType: data.complexType
                    };

                    // Check if this is an imageAssessorData type
                    if (extendsValue === 'imageAssessorData') {
                        showActionBoxEntriesPrompt();
                    } else if (extendsValue === 'abstractProjectAsset') {
                        window.location.reload();
                    } else {
                        showCustomFormPrompt(singular,data.complexType);
                    }
                }).catch(function(error) {
                    console.error('Error parsing response:', error);
                    // Still proceed even if parsing fails
                    window.newDataTypeInfo = {
                        name: name,
                        extendsValue: extendsValue,
                        singular: singular,
                        plural: plural
                    };
                    if (extendsValue === 'imageAssessorData') {
                        showActionBoxEntriesPrompt();
                    } else {
                        showCustomFormPrompt(singular);
                    }
                });
            } else if (response.status === 409) {
                alert('The selected data type already exists');
            } else {
                XNAT.dialog.message({
                    title: 'Error Found',
                    content: 'Error creating data type: ' + response.statusText
                });
            }
        }).catch(function(error) {
//            XNAT.dialog.closeAll();
            XNAT.dialog.message({
                title: 'Error Found',
                content: 'Error creating data type: ' + response.statusText
            });
        });
    }

    function showCreateDataTypeDialog() {
        XNAT.dialog.open({
            title: 'Create Data Type',
            content: document.getElementById('create-datatype-dialog').innerHTML,
            width: 600,
            height: 720,
            beforeShow: function(){
                XNAT.xhr.getJSON({
                    url: XNAT.url.restUrl('/data/search/elements'),
                    success: function(data){ XNAT.data.xftElements = data.ResultSet.Result }
                });
            },
            buttons: [
                {
                    label: 'Save',
                    isDefault: true,
                    close: false,
                    action: function() {
                        submitCreateDataType();
                    }
                },
                {
                    label: 'Cancel',
                    close: true
                }
            ]
        });

        // Add CSS class to dialog for height management
        jq('.ui-dialog:visible').addClass('create-datatype-dialog');
    }

    function showActionBoxEntriesPrompt() {
        XNAT.dialog.open({
            title: 'Add Action Box Entries',
            content: '<div style="padding: 20px;">' +
                     '<p>Would you like to add Action Box Entries for the new data type to existing image session data types?</p>' +
                     '</div>',
            width: 450,
            height: 200,
            buttons: [
                {
                    label: 'Yes',
                    isDefault: true,
                    close: false,
                    action: function() {
                        XNAT.dialog.closeAll();
                        showImageSessionSelection();
                    }
                },
                {
                    label: 'No',
                    close: false,
                    action: function() {
                        XNAT.dialog.closeAll();
                        showCustomFormPrompt(window.newDataTypeInfo.singular,window.newDataTypeInfo.complexType);
                    }
                }
            ]
        });
    }

    function showImageSessionSelection() {
        var singular = window.newDataTypeInfo.singular;

        // Filter available_elements to get only image sessions
        var imageSessions = (window.available_elements || []).filter(function(element) {
            return element.isImageSession === true;
        });

        if (imageSessions.length === 0) {
            alert('No image session data types found.');
            showCustomFormPrompt(window.newDataTypeInfo.singular,window.newDataTypeInfo.complexType);
            return;
        }

        // Build checkbox list HTML
        var checkboxesHtml = '<div style="padding: 20px;">' +
                            '<p style="margin-bottom: 15px;">Which data types do you want to create new <strong>' + singular + '</strong> entries from?</p>' +
                            '<div style="max-height: 300px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">';

        imageSessions.forEach(function(session, index) {
            checkboxesHtml += '<div style="margin-bottom: 8px;">' +
                             '<label style="cursor: pointer;">' +
                             '<input type="checkbox" class="image-session-checkbox" value="' + session.elementName + '" data-plural="' + session.plural + '" style="margin-right: 8px;">' +
                             session.plural +
                             '</label>' +
                             '</div>';
        });

        checkboxesHtml += '</div></div>';

        XNAT.dialog.open({
            title: 'Select Image Session Data Types',
            content: checkboxesHtml,
            width: 500,
            height: 450,
            buttons: [
                {
                    label: 'Continue',
                    isDefault: true,
                    close: false,
                    action: function() {
                        var selectedSessions = [];
                        jq('.image-session-checkbox:checked').each(function() {
                            selectedSessions.push({
                                elementName: jq(this).val(),
                                plural: jq(this).data('plural')
                            });
                        });

                        // Store selected sessions for later processing
                        window.selectedImageSessions = selectedSessions;

                        // Add actions to each selected image session type
                        if (selectedSessions.length > 0) {
                            XNAT.dialog.closeAll();

                            // Show progress dialog
                            XNAT.dialog.open({
                                title: 'Adding Action Box Entries',
                                content: '<div style="padding: 20px; text-align: center;"><div style="margin-bottom: 15px;">Adding action box entries to ' + selectedSessions.length + ' image session type(s)...</div><div class="progress-bar"><div class="progress-bar-fill"></div></div></div>',
                                width: 400,
                                height: 150,
                                buttons: [],
                                closable: false
                            });

                            var promises = [];

                            selectedSessions.forEach(function(session) {
                                var actionData = [{
                                    "popup": "never",
                                    "displayName": "Add " + window.newDataTypeInfo.singular,
                                    "secureAccess": "edit",
                                    "name": "XDATScreen_addia_xnat_imageAssessorData",
                                    "grouping": "Assessments",
                                    "parameterString":"/xsiType/"+window.newDataTypeInfo.complexType
                                }];

                                var url = XNAT.url.csrfUrl('/xapi/datatypes/' + encodeURIComponent(session.elementName) + '/actions');

                                var promise = fetch(url, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(actionData)
                                }).catch(function(error) {
                                    console.error('Error adding action to ' + session.elementName + ':', error);
                                });

                                promises.push(promise);
                            });

                            Promise.all(promises).then(function() {
                                XNAT.dialog.closeAll();
                                showCustomFormPrompt(window.newDataTypeInfo.singular,window.newDataTypeInfo.complexType);
                            }).catch(function(error) {
                                XNAT.dialog.closeAll();
                                alert('Error adding action box entries: ' + error.message);
                                showCustomFormPrompt(window.newDataTypeInfo.singular,window.newDataTypeInfo.complexType);
                            });
                        } else {
                            XNAT.dialog.closeAll();
                            showCustomFormPrompt(window.newDataTypeInfo.singular,window.newDataTypeInfo.complexType);
                        }
                    }
                },
                {
                    label: 'Cancel',
                    close: false,
                    action: function() {
                        XNAT.dialog.closeAll();
                        showCustomFormPrompt(window.newDataTypeInfo.singular,window.newDataTypeInfo.complexType);
                    }
                }
            ]
        });
    }

    function showCustomFormPrompt(singular = false,complexType = false) {
        XNAT.dialog.open({
            title: 'Data Type Created Successfully',
            content: '<div style="padding: 20px;">' +
                     '<p>Your data type has been created successfully.</p>' +
                     '<p>Would you like to create a Custom Form for this data type?</p>' +
                     '</div>',
            width: 450,
            height: 200,
            buttons: [
                {
                    label: 'Create Custom Form',
                    isDefault: true,
                    close: false,
                    action: function() {
                        var queryParams = (singular) ? '?label='+encodeURIComponent(singular) : '';
                        queryParams += (complexType) ? '&xsiType='+encodeURIComponent(complexType) : '';
                        window.location.href = XNAT.url.rootUrl('/app/template/FormManagerDashBoard.vm' + queryParams);
                    }
                },
                {
                    label: 'No, Reload Page',
                    close: false,
                    action: function() {
                        window.location.reload();
                    }
                }
            ]
        });
    }

    //ts_makeSortable(document.getElementById('data-type-table'));

    //jq('#data-type-table').tableSort();

</script>

<script type="text/javascript" src="$content.getURI('scripts/ConfigureSearchFields.js')"></script>
<script type="text/javascript" src="$content.getURI('scripts/ConfigureSearchViews.js')"></script>
<script type="text/javascript">
    // Wrapper to handle Fields tab IDs
    function initFieldsTab() {
        // Temporarily rename IDs to what the script expects
        jq('#selectElementsFields').attr('id', 'selectElements');
        jq('#listOfFieldsFields').attr('id', 'listOfFields');
        jq('#tableOfElementsFields').attr('id', 'tableOfElements');

        window.managerFields = new ConfigureSearchFields("#selectElements");
        window.manager = window.managerFields; // Set manager to point to managerFields for compatibility

        // Override init to sort elements alphabetically
        var originalFieldsInit = window.managerFields.init;
        window.managerFields.init = function() {
            var that = this;
            jq.get(this.url)
                .done(function (data) {
                    that.selectId.empty();
                    that.selectId.append($("<option></option>")
                        .attr("value", "")
                        .text("SELECT"));

                    // Sort results alphabetically by SINGULAR
                    var sortedResults = data.ResultSet.Result.sort(function(a, b) {
                        return a.SINGULAR.localeCompare(b.SINGULAR);
                    });

                    jq(sortedResults).each(function(index, obj){
                        that.selectId.append($("<option></option>")
                            .attr("value", obj.ELEMENT_NAME)
                            .text(obj.SINGULAR));
                    });
                })
                .fail(function (xhr, status, error) {
                    showMessage("page_body", "Error", "Failed to load setting into control " + that.id + ": [" + xhr.status + "] " + error);
                });
        };

        // Override handleValueSubmit for ConfigureSearchFields
        window.handleValueSubmit = function(obj1, obj2, obj3, obj4) {
            var enteredValue = manager.valueDefinitionInput.value;
            try {
                if(enteredValue == "") {
                    displayError("Please specify a filter value.");
                    return false;
                }

                if(!(new RegExp('^[A-Za-z0-9 _]+$')).test(enteredValue)) {
                    displayError("Invalid characters specified.");
                    return false;
                }

                manager.newField.value = enteredValue;
                manager.newField.fieldId = manager.newField.fieldId + "=" + enteredValue;
                manager.newField.HEADER = enteredValue;
                manager.newField.header = enteredValue;
                manager.newField.DESC = enteredValue;
                manager.newField.desc = enteredValue;
                manager.addField();
                manager.valuePopup.destroy();
                manager.newField = null;
            } catch(e) {
                displayError(e.message);
            }
        };

        window.handleValueCancel = function() {
            manager.newField = null;
            manager.valuePopup.destroy();
        };

        // Override loadFields to validate element selection before loading
        var originalLoadFields = window.managerFields.loadFields;
        window.managerFields.loadFields = function() {
            var elementName = jq("#selectElements").val();
            if(!elementName) {
                showMessage("page_body", "Error", "Please select an element.");
                return;
            }
            originalLoadFields.call(this);
        };

        window.managerFields.init();
    }

    // Wrapper to handle Views tab IDs
    function initViewsTab() {
        // Temporarily rename IDs to what the script expects
        jq('#selectElementsViews').attr('id', 'selectElements');
        jq('#listOfFieldsViews').attr('id', 'listOfFields');
        jq('#tableOfElementsViews').attr('id', 'tableOfElements');
        jq('#newFieldContainerViews').attr('id', 'newFieldContainer');
        jq('#addFieldElementViews').attr('id', 'addFieldElement');
        jq('#addFieldIdViews').attr('id', 'addFieldId');
        jq('#addFieldButtonViews').attr('id', 'addFieldButton');

        window.managerViews = new ConfigureSearchViews("#selectElements");
        window.manager = window.managerViews; // Set manager to point to managerViews for compatibility

        // Override handleValueSubmit for ConfigureSearchViews
        window.handleValueSubmit = function(obj1, obj2, obj3, obj4) {
            var enteredValue = manager.valueDefinitionInput.value;
            try {
                if(enteredValue == "") {
                    displayError("Please specify a filter value.");
                    return false;
                }

                if(!(new RegExp('^[A-Za-z0-9 _]+$')).test(enteredValue)) {
                    displayError("Invalid characters specified.");
                    return false;
                }

                manager.newField.value = enteredValue;
                manager.newField.fieldId = manager.newField.fieldId + "=" + enteredValue;
                manager.newField.header = enteredValue;
                manager.newField.HEADER = enteredValue;
                manager.newField.desc = enteredValue;
                manager.newField.DESC = enteredValue;
                manager.addFieldAndUpdate(manager.newField);
                manager.valuePopup.destroy();
                manager.newField = null;
            } catch(e) {
                displayError(e.message);
            }
        };

        window.handleValueCancel = function() {
            manager.newField = null;
            manager.valuePopup.destroy();
        };

        // Override addFieldAndUpdate to enable save button when a field is added
        var originalAddFieldAndUpdate = window.managerViews.addFieldAndUpdate;
        window.managerViews.addFieldAndUpdate = function(newField) {
            originalAddFieldAndUpdate.call(this, newField);
            enableSaveButton();
        };

        // Override init to use buttons instead of dropdown
        var originalInit = window.managerViews.init;
        window.managerViews.init = function() {
            jq('#addFieldElement').on('change', function() {
                manager.loadNewFields();
            });

            jq('#addFieldButton').on('click', function() {
                manager.addField();
            });

            var that = this;
            jq.get(this.url)
                .done(function (data) {
                    // Sort results alphabetically by SINGULAR
                    var sortedResults = data.ResultSet.Result.sort(function(a, b) {
                        return a.SINGULAR.localeCompare(b.SINGULAR);
                    });

                    that.selectId.empty();
                    that.selectId.append($("<option></option>")
                        .attr("value", "")
                        .text("SELECT"));
                    jq(sortedResults).each(function(index, obj){
                        that.selectId.append($("<option></option>")
                            .attr("value", obj.ELEMENT_NAME)
                            .text(obj.SINGULAR));
                    });

                    var addFieldElement = $("#addFieldElement");
                    addFieldElement.empty();
                    addFieldElement.append($("<option></option>")
                        .attr("value", "")
                        .text("SELECT"));
                    jq(sortedResults).each(function(index, obj){
                        addFieldElement.append($("<option></option>")
                            .attr("value", obj.ELEMENT_NAME)
                            .text(obj.SINGULAR));
                    });
                    $("#newFieldContainer").show();
                })
                .fail(function (xhr, status, error) {
                    showMessage("page_body", "Error", "Failed to load setting into control " + that.id + ": [" + xhr.status + "] " + error);
                });
        };

        // Override resetForm to clear table
        window.managerViews.resetForm = function(){
            this.currentVersion=null;
            this.newField=null;
            jq("#listOfFields").html("");
        };

        // Add new method to load view buttons
