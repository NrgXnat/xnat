    // Drag and drop functionality
    function enableDragAndDrop() {
        var draggedElement = null;
        var draggedIndex = null;

        jq('#listOfFields tr[draggable="true"]').on('dragstart', function(e) {
            draggedElement = this;
            draggedIndex = parseInt(jq(this).attr('data-index'));
            jq(this).addClass('dragging');
            e.originalEvent.dataTransfer.effectAllowed = 'move';
            e.originalEvent.dataTransfer.setData('text/html', this.innerHTML);
        });

        jq('#listOfFields tr[draggable="true"]').on('dragend', function(e) {
            jq(this).removeClass('dragging');
            jq('#listOfFields tr').removeClass('drag-over');
        });

        jq('#listOfFields tr[draggable="true"]').on('dragover', function(e) {
            if (e.preventDefault) {
                e.preventDefault();
            }
            e.originalEvent.dataTransfer.dropEffect = 'move';
            return false;
        });

        jq('#listOfFields tr[draggable="true"]').on('dragenter', function(e) {
            jq('#listOfFields tr').removeClass('drag-over');
            if (this !== draggedElement) {
                jq(this).addClass('drag-over');
            }
        });

        jq('#listOfFields tr[draggable="true"]').on('dragleave', function(e) {
            jq(this).removeClass('drag-over');
        });

        jq('#listOfFields tr[draggable="true"]').on('drop', function(e) {
            if (e.stopPropagation) {
                e.stopPropagation();
            }

            if (draggedElement !== this) {
                var dropIndex = parseInt(jq(this).attr('data-index'));

                // Reorder fields in the manager's data
                var movedField = manager.currentVersion.fields[draggedIndex];
                manager.currentVersion.fields.splice(draggedIndex, 1);
                manager.currentVersion.fields.splice(dropIndex, 0, movedField);

                // Update sortOrder for all fields
                jq(manager.currentVersion.fields).each(function(index, field) {
                    field.sortOrder = index;
                });

                // Re-render the table
                manager.renderFields();

                // Enable save button after reordering
                enableSaveButton();
            }

            jq('#listOfFields tr').removeClass('drag-over');
            return false;
        });
    }

