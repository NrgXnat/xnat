    // Show element details in the side panel
    function showElementDetails(fullElementName) {
        var detailsPanel = jq("#element-details-panel");

        // Show loading state
        detailsPanel.html('<div style="color: #999; text-align: center; padding: 40px;">Loading element details...</div>');

        // Parse the element name to get prefix and element name
        var parts = fullElementName.split(':');
        var prefix = parts.length > 1 ? parts[0] : 'xnat';
        var elementName = parts.length > 1 ? parts[1] : parts[0];

        // Fetch element details
        jq.get(serverRoot + "/xapi/xft/schemas/" + prefix + "/elements/" + elementName + "?format=json")
            .done(function (elementData) {
                // Cache the element data
                loadedElements[fullElementName] = elementData;

                // Fetch element fields
                jq.get(serverRoot + "/xapi/xft/schemas/" + prefix + "/elements/" + elementName + "/fields?format=json")
                    .done(function (fieldsData) {
                        // Build the content
                        var html = '<h3>' + (elementData.fullXMLName || fullElementName) + '</h3>';
                        html += '<div class="element-tree">';
                        html += buildFieldTree(fieldsData, fullElementName, 0);
                        html += '</div>';

                        detailsPanel.html(html);
                    })
                    .fail(function (xhr, status, error) {
                        detailsPanel.html('<div style="color: red; padding: 20px;">Failed to load element fields: ' + error + '</div>');
                    });
            })
            .fail(function (xhr, status, error) {
                detailsPanel.html('<div style="color: red; padding: 20px;">Failed to load element details: ' + error + '</div>');
            });
    }

    // Build field tree HTML
    function buildFieldTree(fields, parentPath, depth) {
        var html = '<div class="tree-node' + (depth > 0 ? ' child' : '') + '">';

        jq(fields).each(function(index, field) {
            // Sanitize parentPath to remove special characters
            var sanitizedParent = parentPath.replace(/\//g, '_').replace(/:/g, '_').replace(/'/g, '_');
            // Create field ID without escaping (for use in HTML IDs)
            var fieldId = sanitizedParent + '_' + (field.name || '').replace(/\//g, '_').replace(/:/g, '_').replace(/'/g, '_') + '_' + depth + '_' + index;
            var isReference = field.fieldType === 'referenceField';
            var hasReference = isReference && field.referenceElement && field.referenceElement.fullXMLName;

            html += '<div class="tree-field">';

            // Add expand icon for reference fields
            if (hasReference) {
                // Escape quotes only for the onclick attribute
                var fieldIdEscaped = fieldId.replace(/'/g, "\\'");
                var referenceType = (field.referenceElement.fullXMLName || '').replace(/'/g, "\\'");
                html += '<span class="tree-expand-icon" id="icon_' + fieldId +
                        '" onclick="toggleFieldReference(\'' + fieldIdEscaped + '\', \'' + referenceType + '\'); return false;"></span>';
            } else {
                html += '<span style="display:inline-block;width:20px;"></span>';
            }

            // Field name
            html += '<span class="tree-field-name">' + (field.name || '') + '</span>';

            // Field type
            if (field.xmlType && field.xmlType.fullForeignType) {
                if (hasReference) {
                    var fieldIdEscaped = fieldId.replace(/'/g, "\\'");
                    var referenceType = (field.referenceElement.fullXMLName || '').replace(/'/g, "\\'");
                    html += '<span class="tree-reference-type" onclick="toggleFieldReference(\'' + fieldIdEscaped + '\', \'' + referenceType + '\'); return false;" style="cursor: pointer;">' +
                            field.xmlType.fullForeignType + '</span>';
                } else {
                    html += '<span class="tree-field-type">' + field.xmlType.fullForeignType + '</span>';
                }
            }

            // Additional field info
            var info = [];
            if (field.required) info.push('required');
            if (field.fieldType) info.push(field.fieldType);
            if (info.length > 0) {
                html += '<span class="tree-field-info">(' + info.join(', ') + ')</span>';
            }

            // Container for child fields (reference expansion)
            if (hasReference) {
                html += '<div class="tree-children" id="children_' + fieldId + '"></div>';
            }

            html += '</div>';
        });

        html += '</div>';
        return html;
    }

    // Toggle reference field expansion
    function toggleFieldReference(fieldId, referenceType) {
        console.log('toggleFieldReference called');
        console.log('fieldId:', fieldId);
        console.log('referenceType:', referenceType);

        var childrenContainer = jq('#children_' + fieldId);
        console.log('childrenContainer selector:', '#children_' + fieldId);
        console.log('childrenContainer found:', childrenContainer.length);

        var expandIcon = jq('#icon_' + fieldId);
        console.log('expandIcon selector:', '#icon_' + fieldId);
        console.log('expandIcon found:', expandIcon.length);

        if (childrenContainer.length === 0) {
            console.error('ERROR: childrenContainer not found!');
            alert('ERROR: Could not find children container with ID: children_' + fieldId);
            return;
        }

        if (childrenContainer.hasClass('expanded')) {
            // Collapse
            console.log('Collapsing...');
            childrenContainer.removeClass('expanded');
            expandIcon.removeClass('expanded');
        } else {
            // Expand
            console.log('Expanding...');
            console.log('Children count:', childrenContainer.children().length);

            if (childrenContainer.children().length === 0) {
                // Load the referenced element's fields
                console.log('Loading fields from server...');
                childrenContainer.html('<p style="margin-left:20px;color:#999;">Loading...</p>');

                var parts = referenceType.split(':');
                var prefix = parts.length > 1 ? parts[0] : 'xnat';
                var elementName = parts.length > 1 ? parts[1] : parts[0];

                console.log('Prefix:', prefix);
                console.log('Element name:', elementName);

                var url = serverRoot + "/xapi/xft/schemas/" + prefix + "/elements/" + elementName + "/fields?format=json";
                console.log('Fetching URL:', url);

                jq.get(url)
                    .done(function (fieldsData) {
                        console.log('Fields data received:', fieldsData);
                        var depth = fieldId.split('_').length - 2;
                        console.log('Depth:', depth);
                        var treeHtml = buildFieldTree(fieldsData, fieldId, depth + 1);
                        console.log('Tree HTML generated, length:', treeHtml.length);
                        console.log('Setting HTML to childrenContainer...');
                        childrenContainer.html(treeHtml);
                        console.log('HTML set. Content:', childrenContainer.html().substring(0, 100));
                        childrenContainer.addClass('expanded');
                        expandIcon.addClass('expanded');
                        console.log('Expansion complete');
                    })
                    .fail(function (xhr, status, error) {
                        console.error('AJAX failed:', error);
                        childrenContainer.html('<p style="margin-left:20px;color:red;">Error loading fields: ' + error + '</p>');
                    });
            } else {
                console.log('Already loaded, just showing...');
                childrenContainer.addClass('expanded');
                expandIcon.addClass('expanded');
            }
        }
    }

    // Load Dynamic Data Types
    function loadDynamicDataTypes() {
        var tbody = jq("#dynamicDatatypesTableBody");
        tbody.html("<tr><td colspan='4' style='text-align: center;'>Loading...</td></tr>");

        jq.get(serverRoot + "/xapi/dbschemas?format=json")
            .done(function (data) {
                tbody.empty();

                if (data && data.length > 0) {
                    data = data.sort(function(a,b){ return (a.name < b.name) ? -1 : 1 });
                    jq(data).each(function(index, schema) {
                        var row = "<tr>";
                        row += "<td>" + (schema.name || "") + "</td>";
                        row += "<td>" + (schema.path || "") + "</td>";

                        // Get element names for this schema from the API payload
                        var elementNames = Array.isArray(schema.elements) ? schema.elements : [];
                        if (!Array.isArray(schema.elements) && schema.elements) {
                            console.warn("Unexpected schema.elements format:", schema.elements);
                        }

                        var elementList = elementNames.length > 0 ? elementNames.join(", ") : "None";
                        row += "<td><small>" + elementList + "</small></td>";

                        row += "<td>";
                        row += "<button class='btn btn-sm' onclick='reloadDynamicDataType(" +
                               schema.id + ", \"" + (schema.name || "").replace(/"/g, "&quot;") +
                               "\"); return false;' style='margin-right: 5px;'>Reload</button>";
                        row += "<button class='btn btn-sm' onclick='downloadSchema(" +
                               schema.id + ", \"" + (schema.name || "").replace(/"/g, "&quot;") +
                               "\"); return false;' style='margin-right: 5px;'>Download Schema</button>";
                        row += "<button class='btn btn-sm' onclick='deleteDynamicDataType(" +
                               schema.id + ", \"" + (schema.name || "").replace(/"/g, "&quot;") +
                               "\"); return false;'><i class='fa fa-trash' style='padding-right: 3px'></i> Delete</button>";
                        row += "</td>";
                        row += "</tr>";
                        tbody.append(row);
                    });
                } else {
                    tbody.append("<tr><td colspan='4' style='text-align: center;'>No dynamic data types found</td></tr>");
                }
            })
            .fail(function (xhr, status, error) {
                tbody.empty();
                tbody.append("<tr><td colspan='4' style='color: red; text-align: center;'>Failed to load dynamic data types: [" + xhr.status + "] " + error + "</td></tr>");
            });
    }

    // Reload Dynamic Data Type
    function reloadDynamicDataType(schemaId, schemaName) {
        if (!confirm("Are you sure you want to reload the data type '" + schemaName + "' into the runtime configuration?")) {
            return;
        }

        // Disable all buttons during reload
        jq("#dynamicDatatypesTableBody button").prop("disabled", true);

        jq.ajax({
            url: XNAT.url.restUrl("/xapi/dbschemas/" + schemaId + "/load"),
            type: "POST",
            dataType: "json",
            success: function(response) {
                var message = response.message || "Data type loaded successfully";
                if (response.status === "already_loaded") {
                    showMessage("page_body", "Info", "Data type '" + schemaName + "' is already loaded in the system.");
                } else if (response.status === "loaded") {
                    showMessage("page_body", "Success", "Data type '" + schemaName + "' has been loaded successfully.");
                } else {
                    showMessage("page_body", "Success", message);
                }
                // Re-enable buttons
                jq("#dynamicDatatypesTableBody button").prop("disabled", false);
            },
            error: function(xhr, status, error) {
                var errorMsg = "Failed to load data type";
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.error) {
                        errorMsg = response.error;
                    }
                } catch (e) {
                    errorMsg = "Failed to load data type: [" + xhr.status + "] " + error;
                }
                showMessage("page_body", "Error", errorMsg);
                // Re-enable buttons
                jq("#dynamicDatatypesTableBody button").prop("disabled", false);
            }
        });
    }

    // Delete Dynamic Data Type
    function deleteDynamicDataType(schemaId, schemaName) {
        if (!confirm("Are you sure you want to delete the data type '" + schemaName + "'?\n\nThis will also delete all associated ElementDisplay entries for elements in this schema.")) {
            return;
        }

        // Disable all delete buttons during deletion
        jq("#dynamicDatatypesTableBody button").prop("disabled", true);

        jq.ajax({
            url: XNAT.url.csrfUrl("/xapi/dbschemas/" + schemaId),
            type: "DELETE",
            dataType: "json",
            success: function(response) {
                showMessage("page_body", "Success", "Data type '" + schemaName + "' has been deleted successfully.  Some references may remain until the next Tomcat restart.");
                // Reload the data types table
                loadDynamicDataTypes();
            },
            error: function(xhr, status, error) {
                var errorMsg = "Failed to delete data type";
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.error) {
                        errorMsg = response.error;
                    }
                } catch (e) {
                    errorMsg = "Failed to delete data type: [" + xhr.status + "] " + error;
                }
                showMessage("page_body", "Error", errorMsg);
                // Re-enable delete buttons
                jq("#dynamicDatatypesTableBody button").prop("disabled", false);
            }
        });
    }

