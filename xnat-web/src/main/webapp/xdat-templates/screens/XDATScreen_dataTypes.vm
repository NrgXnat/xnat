            .fail(function (xhr, status, error) {
                tbody.empty();
                tbody.append("<tr><td colspan='2' style='color: red; text-align: center;'>Failed to load display docs: [" + xhr.status + "] " + error + "</td></tr>");
            });
    }

    // Show details for a specific display doc
    function showDisplayDocDetails(elementName) {
        var panel = jq("#display-doc-details-panel");
        panel.html('<div style="color: #999; text-align: center; padding: 40px;">Loading details...</div>');

        jq.get(serverRoot + "/xapi/elementdisplays/" + encodeURIComponent(elementName) + "?format=json")
            .done(function (ed) {
                var html = '';

                // Header with element name and delete button
                html += '<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">';
                html += '<h3 style="margin: 0;">' + (ed.elementName || '') + '</h3>';
                html += '<button class="btn btn-sm" onclick="deleteDisplayDoc(\'' + (ed.elementName || '').replace(/'/g, "\\'") + '\')"><i class="fa fa-trash" style="padding-right: 3px"></i> Delete</button>';
                html += '</div>';

                // Properties section
                html += '<div class="display-doc-section">';
                html += '<div class="display-doc-section-header">Properties</div>';
                html += '<div class="display-doc-section-body">';
                html += buildPropRow('Element Name', ed.elementName);
                html += buildPropRow('Display Label', ed.displayLabel);
                html += buildPropRow('Display Field', ed.displayField);
                html += buildPropRow('Value Field', ed.valueField);
                html += buildPropRow('Brief Description', ed.briefDescription);
                html += buildPropRow('Full Description', ed.fullDescription);
                html += buildPropRow('Light Color', ed.lightColor);
                html += buildPropRow('Dark Color', ed.darkColor);
                html += buildPropRow('Sort Order', ed.sortOrder);
                html += '</div></div>';

                // Display Fields section
                if (ed.displayFields && ed.displayFields.length > 0) {
                    html += '<div class="display-doc-section">';
                    html += '<div class="display-doc-section-header" onclick="jq(this).next().toggle()">Display Fields (' + ed.displayFields.length + ')</div>';
                    html += '<div class="display-doc-section-body">';
                    html += '<table class="display-doc-child-table">';
                    html += '<thead><tr><th>Field ID</th><th>Header</th><th>Searchable</th><th>Visible</th><th>Data Type</th></tr></thead>';
                    html += '<tbody>';
                    jq(ed.displayFields).each(function(i, df) {
                        html += '<tr>';
                        html += '<td>' + escapeHtml(df.fieldId || '') + '</td>';
                        html += '<td>' + escapeHtml(df.header || '') + '</td>';
                        html += '<td>' + (df.searchable ? 'Yes' : 'No') + '</td>';
                        html += '<td>' + (df.visible ? 'Yes' : 'No') + '</td>';
                        html += '<td>' + escapeHtml(df.dataType || '') + '</td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    html += '</div></div>';
                }

                // Display Versions section
                if (ed.displayVersions && ed.displayVersions.length > 0) {
                    html += '<div class="display-doc-section">';
                    html += '<div class="display-doc-section-header" onclick="jq(this).next().toggle()">Display Versions (' + ed.displayVersions.length + ')</div>';
                    html += '<div class="display-doc-section-body">';
                    html += '<table class="display-doc-child-table">';
                    html += '<thead><tr><th>Version Name</th><th>Description</th><th>Default Order By</th><th>Sort Order</th><th>Allow Diffs</th></tr></thead>';
                    html += '<tbody>';
                    jq(ed.displayVersions).each(function(i, dv) {
                        html += '<tr>';
                        html += '<td>' + escapeHtml(dv.versionName || '') + '</td>';
                        html += '<td>' + escapeHtml(dv.briefDescription || '') + '</td>';
                        html += '<td>' + escapeHtml(dv.defaultOrderBy || '') + '</td>';
                        html += '<td>' + escapeHtml(dv.defaultSortOrder || '') + '</td>';
                        html += '<td>' + (dv.allowDiffs ? 'Yes' : 'No') + '</td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    html += '</div></div>';
                }

                // Arcs section
                if (ed.arcs && ed.arcs.length > 0) {
                    html += '<div class="display-doc-section">';
                    html += '<div class="display-doc-section-header" onclick="jq(this).next().toggle()">Arcs (' + ed.arcs.length + ')</div>';
                    html += '<div class="display-doc-section-body">';
                    html += '<table class="display-doc-child-table">';
                    html += '<thead><tr><th>Name</th><th>Common Fields</th></tr></thead>';
                    html += '<tbody>';
                    jq(ed.arcs).each(function(i, arc) {
                        var fields = '';
                        if (arc.commonFields) {
                            var pairs = [];
                            for (var key in arc.commonFields) {
                                if (arc.commonFields.hasOwnProperty(key)) {
                                    pairs.push(escapeHtml(key) + ' = ' + escapeHtml(arc.commonFields[key]));
                                }
                            }
                            fields = pairs.join(', ');
                        }
                        html += '<tr>';
                        html += '<td>' + escapeHtml(arc.name || '') + '</td>';
                        html += '<td>' + fields + '</td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    html += '</div></div>';
                }

                // View Links section
                if (ed.viewLinks && ed.viewLinks.length > 0) {
                    html += '<div class="display-doc-section">';
                    html += '<div class="display-doc-section-header" onclick="jq(this).next().toggle()">View Links (' + ed.viewLinks.length + ')</div>';
                    html += '<div class="display-doc-section-body">';
                    html += '<table class="display-doc-child-table">';
                    html += '<thead><tr><th>Alias</th><th>View</th></tr></thead>';
                    html += '<tbody>';
                    jq(ed.viewLinks).each(function(i, vl) {
                        html += '<tr>';
                        html += '<td>' + escapeHtml(vl.alias || '') + '</td>';
                        html += '<td>' + escapeHtml(vl.view || '') + '</td>';
                        html += '</tr>';
                    });
                    html += '</tbody></table>';
                    html += '</div></div>';
                }

                panel.html(html);
            })
            .fail(function (xhr, status, error) {
                panel.html('<div style="color: red; padding: 20px;">Failed to load display doc details: ' + error + '</div>');
            });
    }

    // Delete a display doc
    function deleteDisplayDoc(elementName) {
        if (!confirm("Are you sure you want to delete the element display for '" + elementName + "'?\n\nThis will remove all configured display configuration (fields, versions, arcs, view links) for this element.\n\nNote: You will need to restart Tomcat after this deletion for the changes to be fully in effect.")) {
            return;
        }

        jq.ajax({
            url: XNAT.url.csrfUrl("/xapi/elementdisplays/" + encodeURIComponent(elementName)),
            type: "DELETE",
            dataType: "json",
            success: function(response) {
                showMessage("page_body", "Success", "Element display for '" + elementName + "' has been deleted successfully.");
                // Reload the list and clear details
                loadDisplayDocs();
            },
            error: function(xhr, status, error) {
                var errorMsg = "Failed to delete element display";
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.error) {
                        errorMsg = response.error;
                    }
                } catch (e) {
                    errorMsg = "Failed to delete element display: [" + xhr.status + "] " + error;
                }
                showMessage("page_body", "Error", errorMsg);
            }
        });
    }

    // Helper: build a property row
    function buildPropRow(label, value) {
        return '<div class="display-doc-prop"><span class="display-doc-prop-label">' + label + ':</span> ' + escapeHtml(value != null ? String(value) : '') + '</div>';
    }

    // Helper: escape HTML to prevent XSS
    function escapeHtml(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }
</script>
