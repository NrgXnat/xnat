</div>

<div id="create-datatype-dialog" style="display:none;">
    <div style="padding: 20px;">
        <h3>Enter the details of the new data type to be created.</h3>
        <form id="create-datatype-form">
            <table>
                <tr>
                    <td style="width: 130px; white-space: nowrap;"><label for="datatype-name">Backend Name:</label></td>
                    <td>
                        <input type="text" id="datatype-name" name="name"
                               pattern="[A-Za-z0-9_]{2,24}"
                               minlength="2"
                               maxlength="24"
                               title="Only letters, numbers, and underscores allowed (2-24 characters)"
                               oninput="this.value = this.value.replace(/[^A-Za-z0-9_]/g, '')"
                               required />
                        <br><small style="color: #666;">Technical identifier used internally (2-24 characters, letters/numbers/underscores only)</small>
                    </td>
                </tr>
                <tr>
                    <td><label for="datatype-extends">Extends:</label></td>
                    <td>
                        <select id="datatype-extends" name="extends" required>
                            <option value="">(SELECT)</option>
                            <option value="subjectAssessorData">subjectAssessorData (Subject Assessment)</option>
                            <option value="imageAssessorData">imageAssessorData (Image Assessment)</option>
                            <option value="abstractProjectAsset">abstractProjectAsset (Project Asset)</option>
                        </select>
                    </td>
                </tr>
                <tr>
                    <td><label for="datatype-singular">Singular Name:</label></td>
                    <td>
                        <input type="text" id="datatype-singular" name="singular"
                               pattern="[A-Za-z0-9_\s]{2,24}"
                               minlength="2"
                               maxlength="24"
                               title="Only letters, numbers, underscores, and spaces allowed (2-24 characters)"
                               oninput="this.value = this.value.replace(/[^A-Za-z0-9_\s]/g, '')"
                               required />
                        <br><small style="color: #666;">Display name for one item (2-24 characters)</small>
                    </td>
                </tr>
                <tr>
                    <td><label for="datatype-plural">Plural Name:</label></td>
                    <td>
                        <input type="text" id="datatype-plural" name="plural"
                               pattern="[A-Za-z0-9_\s]{2,24}"
                               minlength="2"
                               maxlength="24"
                               title="Only letters, numbers, underscores, and spaces allowed (2-24 characters)"
                               oninput="this.value = this.value.replace(/[^A-Za-z0-9_\s]/g, '')"
                               required />
                        <br><small style="color: #666;">Display name for multiple items (2-24 characters)</small>
                    </td>
                </tr>
                <tr>
                    <td colspan="2" style="padding-top: 10px;">
                        <a href="#" id="advanced-settings-toggle" onclick="toggleAdvancedSettings(); return false;" style="color: #666; text-decoration: none;">
                            <span id="advanced-settings-icon">+</span> Advanced Settings
                        </a>
                    </td>
                </tr>
                <tr id="advanced-settings-section" style="display: none;">
                    <td colspan="2">
                        <table style="width: 100%; margin-top: 10px; background-color: #f5f5f5; padding: 10px;">
                            <tr>
                                <td style="width: 40%;"><label for="datatype-prefix">Prefix:</label></td>
                                <td>
                                    <input type="text" id="datatype-prefix" name="prefix"
                                           pattern="[A-Za-z0-9]{2,6}"
                                           minlength="2"
                                           maxlength="6"
                                           title="Only letters and numbers allowed (2-6 characters)"
                                           oninput="this.value = this.value.replace(/[^A-Za-z0-9]/g, '')" />
                                    <br><small style="color: #666;">Schema prefix (2-6 characters, letters/numbers only). Leave blank for auto-generation.</small>
                                </td>
                            </tr>
                            <tr>
                                <td><label for="datatype-complexType">Complex Type:</label></td>
                                <td>
                                    <input type="text" id="datatype-complexType" name="complexType"
                                           pattern="[A-Za-z0-9_]{4,24}"
                                           minlength="4"
                                           maxlength="24"
                                           title="Only letters, numbers, and underscores allowed (4-24 characters)"
                                           oninput="this.value = this.value.replace(/[^A-Za-z0-9_]/g, '')" />
                                    <br><small style="color: #666;">Complex type name (4-24 characters, letters/numbers/underscores). Leave blank for auto-generation.</small>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </form>
    </div>
</div>

<style>
    .progress-bar {
        width: 100%;
        height: 20px;
        background-color: #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #ccc;
    }
    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #4CAF50, #45a049);
        width: 0%;
        border-radius: 10px;
        animation: progress 2s ease-in-out infinite;
    }
    @keyframes progress {
        0% { width: 0%; }
        50% { width: 70%; }
        100% { width: 0%; }
    }

    /* Table grid lines */
    #data-type-table,
    #tableOfElements table,
    #tableOfElementsFields table,
    #tableOfElementsViews table,
    #xft-elements-table,
    #dynamic-datatypes-table {
        border-collapse: collapse;
    }

    #data-type-table th,
    #data-type-table td,
    #tableOfElements table th,
    #tableOfElements table td,
    #tableOfElementsFields table th,
    #tableOfElementsFields table td,
    #tableOfElementsViews table th,
    #tableOfElementsViews table td,
    #xft-elements-table th,
    #xft-elements-table td,
    #dynamic-datatypes-table th,
    #dynamic-datatypes-table td {
        border: 1px solid #ddd;
    }

    /* Element clickable links */
    .element-link {
        color: #0066cc;
        cursor: pointer;
        text-decoration: underline;
    }

    .element-link:hover {
        color: #003d7a;
    }

    /* Search Fields styles */
    div.content-wrapper {
        min-width: 300px;
        max-width: 100%;
        margin: 0 10px;
        position: relative;
        top: 0; bottom: 10px; left: 0; right: 0;
        font-family: Helvetica, Arial, sans-serif
    }

    .mono {
        font-family: Courier, monospace;
        font-size: 13px;
    }

    .dump {
        border-collapse: collapse;
    }

    .dump .info {
        padding-top: 15px;
        padding-bottom: 15px;
    }

    .dump thead {
        border-bottom: 1px solid #a0a0a0;
    }

    .dump th {
        padding: 8px;
        font-size: 14px;
    }

    .dump td {
        padding: 3px 8px;
        vertical-align: top;
    }

    .dump td.tag,
    .dump td.desc {
        white-space: nowrap;
    }

    .dump tbody tr:hover {
        background: #e5f2ff;
    }

    .dump .center {
        text-align: center;
    }

    .dump .left {
        text-align: left;
    }

    /* Drag and drop styles */
    #listOfFieldsViews tr {
        cursor: move;
        transition: background-color 0.2s;
    }

    #listOfFieldsViews tr:hover {
        background-color: #f0f0f0;
    }

    #listOfFieldsViews tr.dragging {
        opacity: 0.5;
        background-color: #e3f2fd;
    }

    #listOfFieldsViews tr.drag-over {
        border-top: 2px solid #2196F3;
    }

    .drag-handle {
        cursor: grab;
        text-align: center;
        user-select: none;
        padding: 8px;
        position: relative;
    }

    .drag-handle:active {
        cursor: grabbing;
    }

    .drag-handle::before {
        content: '';
        display: inline-block;
        width: 20px;
        height: 12px;
        background-image: linear-gradient(to bottom,
            transparent 0%, transparent 20%,
            #999 20%, #999 40%,
            transparent 40%, transparent 60%,
            #999 60%, #999 80%,
            transparent 80%, transparent 100%);
        background-size: 100% 100%;
        background-repeat: no-repeat;
    }

    /* View button styles */
    .view-button {
        margin-right: 8px;
        margin-bottom: 5px;
    }

    .view-button.active {
        background-color: #0D47A1 !important;
        color: white !important;
        border-color: #0D47A1 !important;
    }

    /* Element tree styles */
    .element-tree {
        font-family: monospace;
        line-height: 1.6;
    }

    .tree-node {
        margin-left: 0;
        padding-left: 0;
    }

    .tree-node.child {
        margin-left: 20px;
    }

    .tree-field {
        padding: 3px 0;
        cursor: default;
    }

    .tree-field-name {
        font-weight: bold;
        color: #0066cc;
    }

    .tree-field-type {
        color: #666;
        margin-left: 10px;
    }

    .tree-expand-icon {
        cursor: pointer;
        font-weight: bold;
        user-select: none;
        display: inline-block;
        width: 20px;
        text-align: center;
        color: #0066cc;
    }

    .tree-expand-icon:before {
        content: '+';
    }

    .tree-expand-icon.expanded:before {
        content: '−';
    }

    .tree-expand-icon:hover {
        color: #003d7a;
    }

    .tree-reference-type {
        color: #d14;
        font-style: italic;
        text-decoration: underline;
    }

    .tree-reference-type:hover {
        color: #a00;
    }

    .tree-children {
        display: none;
        margin-left: 20px;
        border-left: 1px dashed #ccc;
        padding-left: 10px;
    }

    .tree-children.expanded {
        display: block;
    }

    .tree-field-info {
        color: #888;
        font-size: 0.9em;
        margin-left: 5px;
    }

    /* Selected element highlight */
    #xft-elements-table tbody tr.selected {
        background-color: #e3f2fd !important;
    }

    #xft-elements-table tbody tr {
        cursor: pointer;
    }

    #xft-elements-table tbody tr:hover {
        background-color: #f5f5f5;
    }

    /* Create Data Type Dialog height management */
    .ui-dialog.create-datatype-dialog {
        height: 450px !important;
    }

    .ui-dialog.create-datatype-dialog.expanded {
        height: 600px !important;
    }
</style>

<script type="text/javascript">

    // Initialize tabs
    var dataTypesTabView = new YAHOO.widget.TabView('data-types-tabs');

    jq('a.data-type-link').click(function(e){
        e.preventDefault();
        XNAT.app.adminPopupDialog(this.href);
        //popupCentered(this.href,' ',960,720,3)
    });

    function toggleAdvancedSettings() {
        var dialog = jq('.xnat-dialog:visible');
        var section = dialog.find('#advanced-settings-section');
        var icon = dialog.find('#advanced-settings-icon');
        var dialogElement = dialog.closest('.ui-dialog');

        if (section.is(':visible')) {
            section.hide();
            icon.text('+');
            dialogElement.removeClass('expanded');
        } else {
            section.show();
            icon.text('-');
            dialogElement.addClass('expanded');
        }
    }

    function submitCreateDataType() {
        var dialog = jq('.xnat-dialog:visible');
        var name = dialog.find('input[name="name"]').val().trim();
        var extendsValue = dialog.find('select[name="extends"]').val();
        var singular = dialog.find('input[name="singular"]').val().trim();
        var plural = dialog.find('input[name="plural"]').val().trim();
        var prefix = dialog.find('input[name="prefix"]').val().trim();
        var complexType = dialog.find('input[name="complexType"]').val().trim();

        if (!name || !extendsValue || !singular || !plural) {
            alert('All fields are required');
            return;
        }

        // Validate advanced settings if provided
        if (prefix) {
            if (prefix.length < 2 || prefix.length > 6 || !/^[A-Za-z0-9]+$/.test(prefix)) {
                alert('Prefix must be 2-6 alphanumeric characters');
                return;
            }
        }

        if (complexType) {
            if (complexType.length < 4 || complexType.length > 24 || !/^[A-Za-z0-9_]+$/.test(complexType)) {
                alert('Complex type must be 4-24 characters (letters, numbers, underscores only)');
                return;
            }
        }
        
        if (!confirm('WARNING: This operation will make structural modifications to your database. This may take several seconds to complete. Do you want to continue?')) {
            return;
        }
        
        XNAT.dialog.open({
            title: 'Creating Data Type',
            content: '<div style="padding: 20px; text-align: center;"><div style="margin-bottom: 15px;">Please wait while the data type is being created...</div><div class="progress-bar"><div class="progress-bar-fill"></div></div></div>',
            width: 400,
            height: 150,
            buttons: [],
            closable: false
        });
        
        var url = '/data/search/elements?task=create&name=' +
                 encodeURIComponent(name) + '&extends=' +
                 encodeURIComponent(extendsValue) + '&singular=' +
                 encodeURIComponent(singular) + '&plural=' +
                 encodeURIComponent(plural);

        // Add optional advanced settings if provided
        if (prefix) {
            url += '&prefix=' + encodeURIComponent(prefix);
        }
        if (complexType) {
            url += '&complexType=' + encodeURIComponent(complexType);
        }

        url += '&XNAT_CSRF=' + window.csrfToken;
        
        fetch(url, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            }
        }).then(function(response) {
            XNAT.dialog.closeAll();
            if (response.ok) {
                // Parse the response to get the complexType
                response.json().then(function(data) {
                    // Store the data type info for later dialogs
                    window.newDataTypeInfo = {
                        name: name,
                        extendsValue: extendsValue,
                        singular: singular,
                        plural: plural,
                        complexType: data.complexType
                    };

                    // Check if this is an imageAssessorData type
                    if (extendsValue === 'imageAssessorData') {
                        showActionBoxEntriesPrompt();
                    } else if (extendsValue === 'abstractProjectAsset') {
                        window.location.reload();
                    } else {
                        showCustomFormPrompt();
                    }
                }).catch(function(error) {
                    console.error('Error parsing response:', error);
                    // Still proceed even if parsing fails
                    window.newDataTypeInfo = {
                        name: name,
                        extendsValue: extendsValue,
                        singular: singular,
                        plural: plural
                    };
                    if (extendsValue === 'imageAssessorData') {
                        showActionBoxEntriesPrompt();
                    } else {
                        showCustomFormPrompt();
                    }
                });
            } else if (response.status === 409) {
                alert('The selected data type already exists');
            } else {
                alert('Error creating data type: ' + response.statusText);
            }
        }).catch(function(error) {
            XNAT.dialog.closeAll();
            alert('Error creating data type: ' + error.message);
        });
    }

    function showCreateDataTypeDialog() {
        XNAT.dialog.open({
            title: 'Create Data Type',
            content: document.getElementById('create-datatype-dialog').innerHTML,
            width: 500,
            height: 600,
            buttons: [
                {
                    label: 'Save',
                    isDefault: true,
                    close: false,
                    action: function() {
                        submitCreateDataType();
                    }
                },
                {
                    label: 'Cancel',
                    close: true
                }
            ]
        });

        // Add CSS class to dialog for height management
        jq('.ui-dialog:visible').addClass('create-datatype-dialog');
    }

    function showActionBoxEntriesPrompt() {
        XNAT.dialog.open({
            title: 'Add Action Box Entries',
            content: '<div style="padding: 20px;">' +
                     '<p>Would you like to add Action Box Entries for the new data type to existing image session data types?</p>' +
                     '</div>',
            width: 450,
            height: 200,
            buttons: [
                {
                    label: 'Yes',
                    isDefault: true,
                    close: false,
                    action: function() {
                        XNAT.dialog.closeAll();
                        showImageSessionSelection();
                    }
                },
                {
                    label: 'No',
                    close: false,
                    action: function() {
                        XNAT.dialog.closeAll();
                        showCustomFormPrompt();
                    }
                }
            ]
        });
    }

    function showImageSessionSelection() {
        var singular = window.newDataTypeInfo.singular;

        // Filter available_elements to get only image sessions
        var imageSessions = (window.available_elements || []).filter(function(element) {
            return element.isImageSession === true;
        });

        if (imageSessions.length === 0) {
            alert('No image session data types found.');
            showCustomFormPrompt();
            return;
        }

        // Build checkbox list HTML
        var checkboxesHtml = '<div style="padding: 20px;">' +
                            '<p style="margin-bottom: 15px;">Which data types do you want to create new <strong>' + singular + '</strong> entries from?</p>' +
                            '<div style="max-height: 300px; overflow-y: auto; border: 1px solid #ccc; padding: 10px; background-color: #f9f9f9;">';

        imageSessions.forEach(function(session, index) {
            checkboxesHtml += '<div style="margin-bottom: 8px;">' +
                             '<label style="cursor: pointer;">' +
                             '<input type="checkbox" class="image-session-checkbox" value="' + session.elementName + '" data-plural="' + session.plural + '" style="margin-right: 8px;">' +
                             session.plural +
                             '</label>' +
                             '</div>';
        });

        checkboxesHtml += '</div></div>';

        XNAT.dialog.open({
            title: 'Select Image Session Data Types',
            content: checkboxesHtml,
            width: 500,
            height: 450,
            buttons: [
                {
                    label: 'Continue',
                    isDefault: true,
                    close: false,
                    action: function() {
                        var selectedSessions = [];
                        jq('.image-session-checkbox:checked').each(function() {
                            selectedSessions.push({
                                elementName: jq(this).val(),
                                plural: jq(this).data('plural')
                            });
                        });

                        // Store selected sessions for later processing
                        window.selectedImageSessions = selectedSessions;

                        // Add actions to each selected image session type
                        if (selectedSessions.length > 0) {
                            XNAT.dialog.closeAll();

                            // Show progress dialog
                            XNAT.dialog.open({
                                title: 'Adding Action Box Entries',
                                content: '<div style="padding: 20px; text-align: center;"><div style="margin-bottom: 15px;">Adding action box entries to ' + selectedSessions.length + ' image session type(s)...</div><div class="progress-bar"><div class="progress-bar-fill"></div></div></div>',
                                width: 400,
                                height: 150,
                                buttons: [],
                                closable: false
                            });

                            var promises = [];

                            selectedSessions.forEach(function(session) {
                                var actionData = [{
                                    "popup": "never",
                                    "displayName": "Add " + window.newDataTypeInfo.singular,
                                    "secureAccess": "edit",
                                    "name": "XDATScreen_addia_xnat_imageAssessorData",
                                    "grouping": "Assessments",
                                    "parameterString":"/xsiType/"+window.newDataTypeInfo.complexType
                                }];

                                var url = '/xapi/datatypes/' + encodeURIComponent(session.elementName) + '/actions?XNAT_CSRF=' + window.csrfToken;

                                var promise = fetch(url, {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json'
                                    },
                                    body: JSON.stringify(actionData)
                                }).catch(function(error) {
                                    console.error('Error adding action to ' + session.elementName + ':', error);
                                });

                                promises.push(promise);
                            });

                            Promise.all(promises).then(function() {
                                XNAT.dialog.closeAll();
                                showCustomFormPrompt();
                            }).catch(function(error) {
                                XNAT.dialog.closeAll();
                                alert('Error adding action box entries: ' + error.message);
                                showCustomFormPrompt();
                            });
                        } else {
                            XNAT.dialog.closeAll();
                            showCustomFormPrompt();
                        }
                    }
                },
                {
                    label: 'Cancel',
                    close: false,
                    action: function() {
                        XNAT.dialog.closeAll();
                        showCustomFormPrompt();
                    }
                }
            ]
        });
    }

    function showCustomFormPrompt() {
        XNAT.dialog.open({
            title: 'Data Type Created Successfully',
            content: '<div style="padding: 20px;">' +
                     '<p>Your data type has been created successfully.</p>' +
                     '<p>Would you like to create a Custom Form for this data type?</p>' +
                     '</div>',
            width: 450,
            height: 200,
            buttons: [
                {
                    label: 'Create Custom Form',
                    isDefault: true,
                    close: false,
                    action: function() {
                        window.location.href = '/app/template/FormManagerDashBoard.vm';
                    }
                },
                {
                    label: 'No, Reload Page',
                    close: false,
                    action: function() {
                        window.location.reload();
                    }
                }
            ]
        });
    }

    //ts_makeSortable(document.getElementById('data-type-table'));

    //jq('#data-type-table').tableSort();

</script>

