                    });
                })
                .fail(function (xhr, status, error) {
                    showMessage("page_body", "Error", "Failed to load setting into control " + that.id + ": [" + xhr.status + "] " + error);
                });
        };

        // Override handleValueSubmit for ConfigureSearchFields
        window.handleValueSubmit = function(obj1, obj2, obj3, obj4) {
            var enteredValue = manager.valueDefinitionInput.value;
            try {
                if(enteredValue == "") {
                    displayError("Please specify a filter value.");
                    return false;
                }

                if(!(new RegExp('^[A-Za-z0-9 _]+$')).test(enteredValue)) {
                    displayError("Invalid characters specified.");
                    return false;
                }

                manager.newField.value = enteredValue;
                manager.newField.fieldId = manager.newField.fieldId + "=" + enteredValue;
                manager.newField.HEADER = enteredValue;
                manager.newField.header = enteredValue;
                manager.newField.DESC = enteredValue;
                manager.newField.desc = enteredValue;
                manager.addField();
                manager.valuePopup.destroy();
                manager.newField = null;
            } catch(e) {
                displayError(e.message);
            }
        };

        window.handleValueCancel = function() {
            manager.newField = null;
            manager.valuePopup.destroy();
        };

        // Override loadFields to validate element selection before loading
        var originalLoadFields = window.managerFields.loadFields;
        window.managerFields.loadFields = function() {
            var elementName = jq("#selectElements").val();
            if(!elementName) {
                showMessage("page_body", "Error", "Please select an element.");
                return;
            }
            originalLoadFields.call(this);
        };

        window.managerFields.init();
    }

    // Wrapper to handle Views tab IDs
    function initViewsTab() {
        // Temporarily rename IDs to what the script expects
        jq('#selectElementsViews').attr('id', 'selectElements');
        jq('#listOfFieldsViews').attr('id', 'listOfFields');
        jq('#tableOfElementsViews').attr('id', 'tableOfElements');
        jq('#newFieldContainerViews').attr('id', 'newFieldContainer');
        jq('#addFieldElementViews').attr('id', 'addFieldElement');
        jq('#addFieldIdViews').attr('id', 'addFieldId');
        jq('#addFieldButtonViews').attr('id', 'addFieldButton');

        window.managerViews = new ConfigureSearchViews("#selectElements");
        window.manager = window.managerViews; // Set manager to point to managerViews for compatibility

        // Override handleValueSubmit for ConfigureSearchViews
        window.handleValueSubmit = function(obj1, obj2, obj3, obj4) {
            var enteredValue = manager.valueDefinitionInput.value;
            try {
                if(enteredValue == "") {
                    displayError("Please specify a filter value.");
                    return false;
                }

                if(!(new RegExp('^[A-Za-z0-9 _]+$')).test(enteredValue)) {
                    displayError("Invalid characters specified.");
                    return false;
                }

                manager.newField.value = enteredValue;
                manager.newField.fieldId = manager.newField.fieldId + "=" + enteredValue;
                manager.newField.header = enteredValue;
                manager.newField.HEADER = enteredValue;
                manager.newField.desc = enteredValue;
                manager.newField.DESC = enteredValue;
                manager.addFieldAndUpdate(manager.newField);
                manager.valuePopup.destroy();
                manager.newField = null;
            } catch(e) {
                displayError(e.message);
            }
        };

        window.handleValueCancel = function() {
            manager.newField = null;
            manager.valuePopup.destroy();
        };

        // Override addFieldAndUpdate to enable save button when a field is added
        var originalAddFieldAndUpdate = window.managerViews.addFieldAndUpdate;
        window.managerViews.addFieldAndUpdate = function(newField) {
            originalAddFieldAndUpdate.call(this, newField);
            enableSaveButton();
        };

        // Override init to use buttons instead of dropdown
        var originalInit = window.managerViews.init;
        window.managerViews.init = function() {
            jq('#addFieldElement').on('change', function() {
                manager.loadNewFields();
            });

            jq('#addFieldButton').on('click', function() {
                manager.addField();
            });

            var that = this;
            jq.get(this.url)
                .done(function (data) {
                    // Sort results alphabetically by SINGULAR
                    var sortedResults = data.ResultSet.Result.sort(function(a, b) {
                        return a.SINGULAR.localeCompare(b.SINGULAR);
                    });

                    that.selectId.empty();
                    that.selectId.append($("<option></option>")
                        .attr("value", "")
                        .text("SELECT"));
                    jq(sortedResults).each(function(index, obj){
                        that.selectId.append($("<option></option>")
                            .attr("value", obj.ELEMENT_NAME)
                            .text(obj.SINGULAR));
                    });

                    var addFieldElement = $("#addFieldElement");
                    addFieldElement.empty();
                    addFieldElement.append($("<option></option>")
                        .attr("value", "")
                        .text("SELECT"));
                    jq(sortedResults).each(function(index, obj){
                        addFieldElement.append($("<option></option>")
                            .attr("value", obj.ELEMENT_NAME)
                            .text(obj.SINGULAR));
                    });
                    $("#newFieldContainer").show();
                })
                .fail(function (xhr, status, error) {
                    showMessage("page_body", "Error", "Failed to load setting into control " + that.id + ": [" + xhr.status + "] " + error);
                });
        };

        // Override resetForm to clear table
        window.managerViews.resetForm = function(){
            this.currentVersion=null;
            this.newField=null;
            jq("#listOfFields").html("");
        };

        // Add new method to load view buttons
        window.managerViews.loadViewButtons = function() {
            var elementName = jq("#selectElements").val();
            if(!elementName) {
                showMessage("page_body", "Error", "Please select an element.");
                return;
            }

            // Clear any previous state
            jq("#primaryViewButtons").empty();
            jq("#otherViewButtons").empty();
            jq("#listOfFields").html("");
            jq(".view-button").removeClass("active");

            jq.get(serverRoot + "/REST/search/elements/" + elementName + "/versions?format=json")
                .done(function (data) {
                    var primaryButtons = jq("#primaryViewButtons");
                    var otherButtons = jq("#otherViewButtons");

                    var hasPrimary = false;
                    var hasOther = false;

                    jq(data.DisplayVersions.versions).each(function(index, obj){
                        if(obj.name === "all") {
                            return;
                        }

                        var buttonText = obj.name;
                        var isPrimary = (obj.name === "listing" || obj.name === "project_bundle");

                        if(obj.name === "listing") {
                            buttonText = "Site Wide (listing)";
                        } else if(obj.name === "project_bundle") {
                            buttonText = "Project (project_bundle)";
                        }

                        var button = $("<button></button>")
                            .attr("data-view", obj.name)
                            .text(buttonText)
                            .addClass("btn1 btn-sm view-button")
                            .on("click", function() {
                                jq(".view-button").removeClass("active");
                                jq(this).addClass("active");
                                manager.selectedView = jq(this).attr("data-view");
                                manager.loadFieldsForView(jq(this).attr("data-view"));
                            });

                        if(isPrimary) {
                            primaryButtons.append(button);
                            hasPrimary = true;
                        } else {
                            otherButtons.append(button);
                            hasOther = true;
                        }
                    });

                    jq("#viewButtonsContainer").show();
                    jq("#otherViewsContainer").toggle(hasOther);
                    jq("#noTableMessage").show();
                    jq("#tableOfElements").hide();
                    jq("#dragDropHint").hide();
                })
                .fail(function (xhr, status, error) {
                    showMessage("page_body", "Error", "Failed to load versions: [" + xhr.status + "] " + error);
                });
        };

        // Add method to load fields for a specific view
        window.managerViews.loadFieldsForView = function(versionName) {
            var elementName = jq("#selectElements").val();
            if(!elementName || !versionName) {
                return;
            }

            jq("#dragDropHint").show();
            jq("#noTableMessage").hide();
            jq("#tableOfElements").show();

            var that = this;
            jq.get(serverRoot + "/REST/search/elements/" + elementName + "/versions/" + versionName + "?format=json&v2=true")
                .done(function (data) {
                    that.currentVersion = data;
                    that.renderFields();
                    // Disable save button when loading fresh data
                    disableSaveButton();
                })
                .fail(function (xhr, status, error) {
                    showMessage("page_body", "Error", "Failed to load fields: [" + xhr.status + "] " + error);
                });
        };

        window.managerViews.init();

        // Override update method to disable save button after successful save
        var originalUpdate = window.managerViews.update;
        window.managerViews.update = function(row) {
            var elementName = jq("#selectElements").val();

            this.updateCurrentVersion();

            openModalPanel("updatingElement","Updating");

            var that = this;
            var value = jq(this.id).val();
            jq.ajax({
                url: serverRoot + "/REST/search/elements/" + elementName + "/versions/modify?version=" + this.currentVersion.versionName + "&XNAT_CSRF=" + window.csrfToken,
                type: 'PUT',
                data: JSON.stringify(this.currentVersion),
                contentType: "application/json"
            })
            .done(function () {
                closeModalPanel("updatingElement");
                // Disable save button after successful save
                disableSaveButton();
            })
            .fail(function (xhr, status, error) {
                closeModalPanel("updatingElement");
                showMessage("page_body", "Failure", "Failed to modify fields; [" + xhr.status + "] " + error);
            });
        };

        // Override renderFields to add drag handles
        var originalRenderFields = window.managerViews.renderFields;
        window.managerViews.renderFields = function() {
            var listOfFields = "";
            jq(this.currentVersion.fields).each(function (fI, field){
                listOfFields += "<TR draggable='true' data-index='" + fI + "'>";
                listOfFields += "<TD class='drag-handle'></TD>";
                listOfFields += "<TD NOWRAP>" + field.sortOrder + "</TD>";
                listOfFields += "<TD NOWRAP>" + field.elementName + "</TD>";
                listOfFields += "<TD>" + field.fieldId + "<input type='hidden' id='element" + fI +"' value='" + field.elementName + "'/><input type='hidden' id='field" + fI +"' value='" + field.fieldId + "'/></TD>";
                listOfFields += "<TD><input type='text' id='header" + fI +"' value='" + field.header + "' style='width:120px' oninput='enableSaveButton();'/></TD>";
                listOfFields += "<TD><input type='text' id='value" + fI +"' value='" + ((field.value==null)?"":field.value) + "' style='width:120px' DISABLED/></TD>";
                listOfFields += "<TD NOWRAP><input type='button' value='Remove' onclick='manager.removeField(" + fI +"); enableSaveButton();'/></TD>";
                listOfFields += "</TR>";
            });
            jq("#listOfFields").html(listOfFields);

            // Enable drag and drop
            enableDragAndDrop();
        };
    }

    // Drag and drop functionality
    function enableDragAndDrop() {
        var draggedElement = null;
        var draggedIndex = null;

        jq('#listOfFields tr[draggable="true"]').on('dragstart', function(e) {
            draggedElement = this;
            draggedIndex = parseInt(jq(this).attr('data-index'));
            jq(this).addClass('dragging');
            e.originalEvent.dataTransfer.effectAllowed = 'move';
            e.originalEvent.dataTransfer.setData('text/html', this.innerHTML);
        });

        jq('#listOfFields tr[draggable="true"]').on('dragend', function(e) {
            jq(this).removeClass('dragging');
            jq('#listOfFields tr').removeClass('drag-over');
        });

        jq('#listOfFields tr[draggable="true"]').on('dragover', function(e) {
            if (e.preventDefault) {
                e.preventDefault();
            }
            e.originalEvent.dataTransfer.dropEffect = 'move';
            return false;
        });

        jq('#listOfFields tr[draggable="true"]').on('dragenter', function(e) {
            jq('#listOfFields tr').removeClass('drag-over');
            if (this !== draggedElement) {
                jq(this).addClass('drag-over');
            }
        });

        jq('#listOfFields tr[draggable="true"]').on('dragleave', function(e) {
            jq(this).removeClass('drag-over');
        });

        jq('#listOfFields tr[draggable="true"]').on('drop', function(e) {
            if (e.stopPropagation) {
                e.stopPropagation();
            }

            if (draggedElement !== this) {
                var dropIndex = parseInt(jq(this).attr('data-index'));

                // Reorder fields in the manager's data
                var movedField = manager.currentVersion.fields[draggedIndex];
                manager.currentVersion.fields.splice(draggedIndex, 1);
                manager.currentVersion.fields.splice(dropIndex, 0, movedField);

                // Update sortOrder for all fields
                jq(manager.currentVersion.fields).each(function(index, field) {
                    field.sortOrder = index;
                });

                // Re-render the table
                manager.renderFields();

                // Enable save button after reordering
                enableSaveButton();
            }

            jq('#listOfFields tr').removeClass('drag-over');
            return false;
        });
    }

    // Enable/disable save button
    function enableSaveButton() {
        var saveBtn = jq('#saveFieldsButtonViews');
        saveBtn.prop('disabled', false);
        saveBtn.css({
            'opacity': '1',
            'cursor': 'pointer'
        });
    }

    function disableSaveButton() {
        var saveBtn = jq('#saveFieldsButtonViews');
        saveBtn.prop('disabled', true);
        saveBtn.css({
            'opacity': '0.5',
            'cursor': 'not-allowed'
        });
    }

    // Restore original IDs for Fields tab
    function restoreFieldsIds() {
        if (jq('#selectElements').closest('#search-fields-tab').length > 0) {
            jq('#selectElements').attr('id', 'selectElementsFields');
            jq('#listOfFields').attr('id', 'listOfFieldsFields');
            jq('#tableOfElements').attr('id', 'tableOfElementsFields');
        }
    }

    // Restore original IDs for Views tab
    function restoreViewsIds() {
        if (jq('#selectElements').closest('#listing-config-tab').length > 0) {
            jq('#selectElements').attr('id', 'selectElementsViews');
            jq('#listOfFields').attr('id', 'listOfFieldsViews');
            jq('#tableOfElements').attr('id', 'tableOfElementsViews');
            jq('#newFieldContainer').attr('id', 'newFieldContainerViews');
            jq('#addFieldElement').attr('id', 'addFieldElementViews');
            jq('#addFieldId').attr('id', 'addFieldIdViews');
            jq('#addFieldButton').attr('id', 'addFieldButtonViews');
        }
    }

    // Reset Search Fields tab
    function resetFieldsTab() {
        jq('#selectElementsFields').val('');
        jq('#listOfFieldsFields').html('');
    }

    // Reset Listing Configuration tab
    function resetViewsTab() {
        jq('#selectElementsViews').val('');
        jq('#primaryViewButtons').html('');
        jq('#otherViewButtons').html('');
        jq('#viewButtonsContainer').hide();
        jq('#listOfFieldsViews').html('');
        jq('#noTableMessage').show();
        jq('#tableOfElementsViews').hide();
        jq('#dragDropHint').hide();
        jq('.view-button').removeClass('active');
    }

    // Load XFT Elements
    function loadXFTElements() {
        var showMeta = jq("#showMetaElements").is(":checked");
        var showHistory = jq("#showHistoryElements").is(":checked");
        var url = serverRoot + "/xapi/xft/elements?format=json&showMeta=" + showMeta + "&showHistory=" + showHistory;

        // Clear the details panel
        jq("#element-details-panel").html('<div style="color: #999; text-align: center; padding: 40px;">Select an element to view its details</div>');

        jq.get(url)
            .done(function (data) {
                var tbody = jq("#xftElementsTableBody");
                tbody.empty();

                if (data && data.length > 0) {
                    jq(data).each(function(index, elementName) {
                        var row = $("<tr></tr>");
                        var cell = $("<td></td>");
                        var link = $("<a class='element-link' href='#'></a>")
                            .text(elementName)
                            .on('click', function(e) {
                                e.preventDefault();
                                // Remove selection from all rows
                                jq("#xft-elements-table tbody tr").removeClass("selected");
                                // Add selection to clicked row
                                row.addClass("selected");
                                showElementDetails(elementName);
                            });
                        cell.append(link);
                        row.append(cell);
                        tbody.append(row);
                    });
                } else {
                    tbody.append("<tr><td>No XFT elements found</td></tr>");
                }
            })
            .fail(function (xhr, status, error) {
                showMessage("page_body", "Error", "Failed to load XFT elements: [" + xhr.status + "] " + error);
            });
    }

    // Handle tab changes
    dataTypesTabView.subscribe("activeTabChange", function(e) {
        var newTab = e.newValue;
        var newIndex = dataTypesTabView.getTabIndex(newTab);

        // Restore IDs before switching
        restoreFieldsIds();
        restoreViewsIds();

        // Reset all tabs when switching
        resetFieldsTab();
        resetViewsTab();

        // Initialize the new tab
        if (newIndex === 1) { // Search Fields tab
            setTimeout(function() {
                initFieldsTab();
            }, 100);
        } else if (newIndex === 2) { // Listing Configuration tab
            setTimeout(function() {
                initViewsTab();
            }, 100);
        } else if (newIndex === 3) { // All XFT Elements tab
            // No auto-initialization needed, user clicks Load button
        } else if (newIndex === 4) { // Dynamic Data Types tab
            // No auto-initialization needed, user clicks Load button
        }
    });

    // Initialize the first tab (Search Fields) on page load
    setTimeout(function() {
        initFieldsTab();
    }, 100);

    // Cache for loaded element data
    var loadedElements = {};

    // Show element details in the side panel
    function showElementDetails(fullElementName) {
        var detailsPanel = jq("#element-details-panel");

        // Show loading state
        detailsPanel.html('<div style="color: #999; text-align: center; padding: 40px;">Loading element details...</div>');

        // Parse the element name to get prefix and element name
        var parts = fullElementName.split(':');
        var prefix = parts.length > 1 ? parts[0] : 'xnat';
        var elementName = parts.length > 1 ? parts[1] : parts[0];

        // Fetch element details
        jq.get(serverRoot + "/xapi/xft/schemas/" + prefix + "/elements/" + elementName + "?format=json")
            .done(function (elementData) {
                // Cache the element data
                loadedElements[fullElementName] = elementData;

                // Fetch element fields
                jq.get(serverRoot + "/xapi/xft/schemas/" + prefix + "/elements/" + elementName + "/fields?format=json")
                    .done(function (fieldsData) {
                        // Build the content
                        var html = '<h3>' + (elementData.fullXMLName || fullElementName) + '</h3>';
                        html += '<div class="element-tree">';
                        html += buildFieldTree(fieldsData, fullElementName, 0);
                        html += '</div>';

                        detailsPanel.html(html);
                    })
                    .fail(function (xhr, status, error) {
                        detailsPanel.html('<div style="color: red; padding: 20px;">Failed to load element fields: ' + error + '</div>');
                    });
            })
            .fail(function (xhr, status, error) {
                detailsPanel.html('<div style="color: red; padding: 20px;">Failed to load element details: ' + error + '</div>');
            });
    }

    // Build field tree HTML
    function buildFieldTree(fields, parentPath, depth) {
        var html = '<div class="tree-node' + (depth > 0 ? ' child' : '') + '">';

        jq(fields).each(function(index, field) {
            // Sanitize parentPath to remove special characters
            var sanitizedParent = parentPath.replace(/\//g, '_').replace(/:/g, '_').replace(/'/g, '_');
            // Create field ID without escaping (for use in HTML IDs)
            var fieldId = sanitizedParent + '_' + (field.name || '').replace(/\//g, '_').replace(/:/g, '_').replace(/'/g, '_') + '_' + depth + '_' + index;
            var isReference = field.fieldType === 'referenceField';
            var hasReference = isReference && field.referenceElement && field.referenceElement.fullXMLName;

            html += '<div class="tree-field">';

            // Add expand icon for reference fields
            if (hasReference) {
                // Escape quotes only for the onclick attribute
                var fieldIdEscaped = fieldId.replace(/'/g, "\\'");
                var referenceType = (field.referenceElement.fullXMLName || '').replace(/'/g, "\\'");
                html += '<span class="tree-expand-icon" id="icon_' + fieldId +
                        '" onclick="toggleFieldReference(\'' + fieldIdEscaped + '\', \'' + referenceType + '\'); return false;"></span>';
            } else {
                html += '<span style="display:inline-block;width:20px;"></span>';
            }

            // Field name
            html += '<span class="tree-field-name">' + (field.name || '') + '</span>';

            // Field type
            if (field.xmlType && field.xmlType.fullForeignType) {
                if (hasReference) {
                    var fieldIdEscaped = fieldId.replace(/'/g, "\\'");
                    var referenceType = (field.referenceElement.fullXMLName || '').replace(/'/g, "\\'");
                    html += '<span class="tree-reference-type" onclick="toggleFieldReference(\'' + fieldIdEscaped + '\', \'' + referenceType + '\'); return false;" style="cursor: pointer;">' +
                            field.xmlType.fullForeignType + '</span>';
                } else {
                    html += '<span class="tree-field-type">' + field.xmlType.fullForeignType + '</span>';
                }
            }

            // Additional field info
            var info = [];
            if (field.required) info.push('required');
            if (field.fieldType) info.push(field.fieldType);
            if (info.length > 0) {
                html += '<span class="tree-field-info">(' + info.join(', ') + ')</span>';
            }

            // Container for child fields (reference expansion)
            if (hasReference) {
                html += '<div class="tree-children" id="children_' + fieldId + '"></div>';
            }

            html += '</div>';
        });

        html += '</div>';
        return html;
    }

    // Toggle reference field expansion
    function toggleFieldReference(fieldId, referenceType) {
        console.log('toggleFieldReference called');
        console.log('fieldId:', fieldId);
        console.log('referenceType:', referenceType);

        var childrenContainer = jq('#children_' + fieldId);
        console.log('childrenContainer selector:', '#children_' + fieldId);
        console.log('childrenContainer found:', childrenContainer.length);

        var expandIcon = jq('#icon_' + fieldId);
        console.log('expandIcon selector:', '#icon_' + fieldId);
        console.log('expandIcon found:', expandIcon.length);

        if (childrenContainer.length === 0) {
            console.error('ERROR: childrenContainer not found!');
            alert('ERROR: Could not find children container with ID: children_' + fieldId);
            return;
        }

        if (childrenContainer.hasClass('expanded')) {
            // Collapse
            console.log('Collapsing...');
            childrenContainer.removeClass('expanded');
            expandIcon.removeClass('expanded');
        } else {
            // Expand
            console.log('Expanding...');
            console.log('Children count:', childrenContainer.children().length);

            if (childrenContainer.children().length === 0) {
                // Load the referenced element's fields
                console.log('Loading fields from server...');
                childrenContainer.html('<p style="margin-left:20px;color:#999;">Loading...</p>');

                var parts = referenceType.split(':');
                var prefix = parts.length > 1 ? parts[0] : 'xnat';
                var elementName = parts.length > 1 ? parts[1] : parts[0];

                console.log('Prefix:', prefix);
                console.log('Element name:', elementName);

                var url = serverRoot + "/xapi/xft/schemas/" + prefix + "/elements/" + elementName + "/fields?format=json";
                console.log('Fetching URL:', url);

                jq.get(url)
                    .done(function (fieldsData) {
                        console.log('Fields data received:', fieldsData);
                        var depth = fieldId.split('_').length - 2;
                        console.log('Depth:', depth);
                        var treeHtml = buildFieldTree(fieldsData, fieldId, depth + 1);
                        console.log('Tree HTML generated, length:', treeHtml.length);
                        console.log('Setting HTML to childrenContainer...');
                        childrenContainer.html(treeHtml);
                        console.log('HTML set. Content:', childrenContainer.html().substring(0, 100));
                        childrenContainer.addClass('expanded');
                        expandIcon.addClass('expanded');
                        console.log('Expansion complete');
                    })
                    .fail(function (xhr, status, error) {
                        console.error('AJAX failed:', error);
                        childrenContainer.html('<p style="margin-left:20px;color:red;">Error loading fields: ' + error + '</p>');
                    });
            } else {
                console.log('Already loaded, just showing...');
                childrenContainer.addClass('expanded');
                expandIcon.addClass('expanded');
            }
        }
    }

    // Load Dynamic Data Types
    function loadDynamicDataTypes() {
        var tbody = jq("#dynamicDatatypesTableBody");
        tbody.html("<tr><td colspan='4' style='text-align: center;'>Loading...</td></tr>");

        jq.get(serverRoot + "/xapi/dbschemas?format=json")
            .done(function (data) {
                tbody.empty();

                if (data && data.length > 0) {
                    jq(data).each(function(index, schema) {
                        var row = "<tr>";
                        row += "<td>" + (schema.name || "") + "</td>";
                        row += "<td>" + (schema.path || "") + "</td>";

                        // Get element names for this schema from the API payload
                        var elementNames = Array.isArray(schema.elements) ? schema.elements : [];
                        if (!Array.isArray(schema.elements) && schema.elements) {
                            console.warn("Unexpected schema.elements format:", schema.elements);
                        }

                        var elementList = elementNames.length > 0 ? elementNames.join(", ") : "None";
                        row += "<td><small>" + elementList + "</small></td>";

                        row += "<td>";
                        row += "<button class='btn1 btn-sm' onclick='reloadDynamicDataType(" +
                               schema.id + ", \"" + (schema.name || "").replace(/"/g, "&quot;") +
                               "\"); return false;' style='margin-right: 5px;'>ReLoad</button>";
                        row += "<button class='btn1 btn-sm' onclick='downloadSchema(" +
                               schema.id + ", \"" + (schema.name || "").replace(/"/g, "&quot;") +
                               "\"); return false;' style='margin-right: 5px;'>Download Schema</button>";
                        row += "<button class='btn1 btn-sm' onclick='deleteDynamicDataType(" +
                               schema.id + ", \"" + (schema.name || "").replace(/"/g, "&quot;") +
                               "\"); return false;'>Delete</button>";
                        row += "</td>";
                        row += "</tr>";
                        tbody.append(row);
                    });
                } else {
                    tbody.append("<tr><td colspan='4' style='text-align: center;'>No dynamic data types found</td></tr>");
                }
            })
            .fail(function (xhr, status, error) {
                tbody.empty();
                tbody.append("<tr><td colspan='4' style='color: red; text-align: center;'>Failed to load dynamic data types: [" + xhr.status + "] " + error + "</td></tr>");
            });
    }

    // Reload Dynamic Data Type
    function reloadDynamicDataType(schemaId, schemaName) {
        if (!confirm("Are you sure you want to reload the data type '" + schemaName + "' into the runtime configuration?")) {
            return;
        }

        // Disable all buttons during reload
        jq("#dynamicDatatypesTableBody button").prop("disabled", true);

        jq.ajax({
            url: serverRoot + "/xapi/dbschemas/" + schemaId + "/load",
            type: "POST",
            dataType: "json",
            success: function(response) {
                var message = response.message || "Data type loaded successfully";
                if (response.status === "already_loaded") {
                    showMessage("page_body", "Info", "Data type '" + schemaName + "' is already loaded in the system.");
                } else if (response.status === "loaded") {
                    showMessage("page_body", "Success", "Data type '" + schemaName + "' has been loaded successfully.");
                } else {
                    showMessage("page_body", "Success", message);
                }
                // Re-enable buttons
                jq("#dynamicDatatypesTableBody button").prop("disabled", false);
            },
            error: function(xhr, status, error) {
                var errorMsg = "Failed to load data type";
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.error) {
                        errorMsg = response.error;
                    }
                } catch (e) {
                    errorMsg = "Failed to load data type: [" + xhr.status + "] " + error;
                }
                showMessage("page_body", "Error", errorMsg);
                // Re-enable buttons
                jq("#dynamicDatatypesTableBody button").prop("disabled", false);
            }
        });
    }

    // Delete Dynamic Data Type
    function deleteDynamicDataType(schemaId, schemaName) {
        if (!confirm("Are you sure you want to delete the data type '" + schemaName + "'?\n\nThis will also delete all associated ElementDisplay entries for elements in this schema.")) {
            return;
        }

        // Disable all delete buttons during deletion
        jq("#dynamicDatatypesTableBody button").prop("disabled", true);

        jq.ajax({
            url: serverRoot + "/xapi/dbschemas/" + schemaId,
            type: "DELETE",
            dataType: "json",
            success: function(response) {
                showMessage("page_body", "Success", "Data type '" + schemaName + "' has been deleted successfully.  Some references may remain until the next Tomcat restart.");
                // Reload the data types table
                loadDynamicDataTypes();
            },
            error: function(xhr, status, error) {
                var errorMsg = "Failed to delete data type";
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.error) {
                        errorMsg = response.error;
                    }
                } catch (e) {
                    errorMsg = "Failed to delete data type: [" + xhr.status + "] " + error;
                }
                showMessage("page_body", "Error", errorMsg);
                // Re-enable delete buttons
                jq("#dynamicDatatypesTableBody button").prop("disabled", false);
            }
        });
    }

    // Download Schema XSD
    function downloadSchema(schemaId, schemaName) {
        window.location.href = serverRoot + "/xapi/dbschemas/" + schemaId + "/schema";
    }
</script>
