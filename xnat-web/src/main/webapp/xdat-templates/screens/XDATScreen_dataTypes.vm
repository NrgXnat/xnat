$page.setTitle("XDAT")
$page.setLinkColor($ui.alink)
$page.setVlinkColor($ui.vlink)
#set ($pageName = "SearchResults.vm")
#set ($template = $data.getTemplateInfo())
$!template.setLayoutTemplate("DefaultExptList.vm")
#set ($currentPage = $currentPage + 1)
#if ($data.message)
<div class="message">$data.message</div><br>
#end
#parse("/screens/admin_bar.vm")

#set ( $url = $link.setPage("XDATScreen_add_xdat_element_security.vm").addPathInfo("popup","true")  )

<div id="data-type-list" class="admin-content">

    <div id="data-types-tabs" class="yui-navset">
        <ul class="yui-nav">
            <li class="selected"><a href="#registered-types-tab"><em>Registered Data Types</em></a></li>
            <li><a href="#search-fields-tab"><em>Search Fields</em></a></li>
            <li><a href="#listing-config-tab"><em>Listing Configuration</em></a></li>
            <li><a href="#xft-elements-tab"><em>All XFT Elements</em></a></li>
            <li><a href="#dynamic-datatypes-tab"><em>Dynamic Data Types</em></a></li>
            <li><a href="#db-display-docs-tab"><em>Dynamic Display Docs</em></a></li>
        </ul>

        <div class="yui-content">
            <div id="registered-types-tab">
                <div class="header">
                    <b>Data Types</b>
                    <i>|</i>
                    <button id="setup-data-type" type="button"
                        ##data-url="$url"
                        ##onclick="return popupCentered('$url','Edit',960,720,3);"
                        onclick="XNAT.app.adminPopupDialog('$url')"
                        class="btn btn-sm">Setup Additional Data Type</button>
                    <button id="create-data-type" type="button"
                        onclick="showCreateDataTypeDialog()"
                        class="btn btn-sm">Create Datatype</button>
                </div>

                <form name="form1" method="post" action="$link.setAction("ManageDataTypes")">

                    <div class="data-table" style="margin-bottom:15px; overflow-x: auto;">
                    <table id="data-type-table" class="xnat-table clean sortable">
                        <thead>
                        <tr>
                            <th class="sort"><b>Element</b></th>
                            <th class="sort name-singular">
                                <span title="Term used to describe one instance of this data.">Singular</span>
                            </th>
                            <th class="sort name-plural">
                                <span title="Term used to describe more than one occurrence of this data.">Plural</span>
                            </th>
                            <th class="sort">
                                <span title="Short code used in the creation of IDs">Code</span>
                            </th>
                            <th class="sort">
                                <span title="Whether or not unspecified users can use this data-type in its $displayManager.getPluralDisplayNameForProject().toLowerCase().">Accessible</span>
                            </th>
                            <th class="sort">
                                <span title="Whether or not access to data of this type should be restricted.">Secured</span>
                            </th>
                            <th class="sort">
                                <span title="Whether or not data of this type should be searchable.">Searchable</span>
                            </th>
                            <th class="sort">
                                <span title="Whether or not data of this type should be browseable.">Browseable</span>
                            </th>
                            <th class="sort">
                                <span title="The order in which data types will show up in listings.">Sequence</span>
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        #set($dt_count=0)
                        #set($row=0)
                        #foreach($data_type in $data_types)
                            #if($row==0)
                            <tr>
                                #set($row=1)
                            #else
                            <tr>
                                #set($row=0)
                            #end

                            #set ( $url = $link.setAction("DisplayItemAction").addPathInfo("search_element","xdat:element_security").addPathInfo("search_field","xdat:element_security.element_name").addPathInfo("search_value","$!data_type.getProperty('element_name')").addPathInfo("popup","true")  )

                            <td>
                                <a class="data-type-link" target="_blank" href="$url">$!data_type.getProperty("element_name")</a>
                            </td>
                            <td class="name-singular">
                                <i class="hidden">$!data_type.getProperty("singular")</i>
                                <input type="text" value="$!data_type.getProperty("singular")"
                                        id="xdat:security/element_security_set/element_security[$dt_count]/singular"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/singular"
                                        size="20">
                            </td>
                            <td class="name-plural">
                                <i class="hidden">$!data_type.getProperty("plural")</i>
                                <input type="text" value="$!data_type.getProperty("plural")"
                                        id="xdat:security/element_security_set/element_security[$dt_count]/plural"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/plural"
                                        size="20">
                            </td>
                            <td class="center">
                                <i class="hidden">$!data_type.getProperty("code")</i>
                                <input type="text" value="$!data_type.getProperty("code")"
                                        id="xdat:security/element_security_set/element_security[$dt_count]/code"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/code"
                                        size="4" maxlength="5">
                            </td>
                            <td class="center">
                                <i class="hidden">#if($!data_type.getBooleanProperty("accessible")) 1 #else 2 #end</i>
                                <input type="checkbox" #if($!data_type.getBooleanProperty("accessible"))checked#end
                                        id="xdat:security/element_security_set/element_security[$dt_count]/accessible"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/accessible"
                                        value="true">
                            </td>
                            <td class="center">
                                <i class="hidden">#if($!data_type.getBooleanProperty("secure")) 1 #else 2 #end</i>
                                <input type="checkbox" #if($!data_type.getBooleanProperty("secure"))checked#end
                                        id="xdat:security/element_security_set/element_security[$dt_count]/secure"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/secure"
                                        value="true">
                            </td>
                            <td class="center">
                                <i class="hidden">#if($!data_type.getBooleanProperty("searchable")) 1 #else 2 #end</i>
                                <input type="checkbox" #if($!data_type.getBooleanProperty("searchable"))checked#end
                                        id="xdat:security/element_security_set/element_security[$dt_count]/searchable"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/searchable"
                                        value="true">
                            </td>
                            <td class="center">
                                <i class="hidden">#if($!data_type.getBooleanProperty("browse")) 1 #else 2 #end</i>
                                <input type="checkbox" #if($!data_type.getBooleanProperty("browse"))checked#end
                                        id="xdat:security/element_security_set/element_security[$dt_count]/browse"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/browse"
                                        value="true">
                            </td>
                            <td class="center">
                                <i class="hidden">$!data_type.getProperty("sequence")</i>
                                <input type="text" value="$!data_type.getProperty("sequence")"
                                        id="xdat:security/element_security_set/element_security[$dt_count]/sequence"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/sequence"
                                        size="2" maxlength="2">
                                <input type="hidden" value="$!data_type.getProperty("element_name")"
                                        id="xdat:security/element_security_set/element_security[$dt_count]/element_name"
                                        name="xdat:security/element_security_set/element_security[$dt_count]/element_name">
                                #set($dt_count=$dt_count + 1)
                            </td>
                        </tr>
                        #end
                        </tbody>
                    </table>

                    </div>

                    <input type="submit" class="btn1" style="float:right;" value="Save">

                    <div class="clear"></div>

                </form>
            </div>

            <div id="search-fields-tab">
                <div style="padding: 10px 0;">
                    <select id="selectElementsFields">
                        <option value="">(SELECT)</option>
                    </select> <input type="button" onclick="manager.loadFields()" value="Load" class="btn btn-sm"/>
                    <p>NOTE: Changing header values here will not impact existing stored searches or Display Versions.</p>
                </div>
                <div class="data-table" style="margin-bottom:15px; overflow-x: auto;" id="tableOfElementsFields">
                    <table class="xnat-table clean sortable">
                        <thead>
                        <tr>
                            <th>Field ID</th>
                            <th>Header</th>
                            <th>Description</th>
                            <th>Searchable</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody id="listOfFieldsFields">
                        </tbody>
                    </table>

                </div>
            </div>

            <div id="listing-config-tab">
                <div style="padding: 10px 0;">
                    <div style="margin-bottom: 15px;">
                        <select id="selectElementsViews">
                            <option value="">(SELECT)</option>
                        </select>
                        <input type="button" id="loadViewsButton" onclick="manager.loadViewButtons()" value="Load" class="btn btn-sm"/>
                    </div>

                    <div id="viewButtonsContainer" style="display: none; margin-bottom: 15px;">
                        <div style="margin-bottom: 10px;">
                            <label style="font-weight: bold; display: block; margin-bottom: 8px;">Primary Listings:</label>
                            <div id="primaryViewButtons" style="margin-bottom: 10px;">
                            </div>
                        </div>

                        <div id="otherViewsContainer" style="display: none;">
                            <label style="font-weight: bold; display: block; margin-bottom: 8px;">Advanced Search Options:</label>
                            <div id="otherViewButtons" style="margin-bottom: 10px;">
                            </div>
                        </div>
                    </div>

                    <p id="dragDropHint" style="color: #666; font-style: italic; margin-top: 10px; display: none;">Drag and drop rows to reorder fields</p>
                </div>
                <div id="noTableMessage" style="padding: 40px; text-align: center; color: #999; font-size: 14px; font-style: italic; background-color: #f9f9f9; border: 1px dashed #ddd; border-radius: 4px; margin-bottom: 15px;">
                    Click a listing above to configure the columns for it
                </div>
                <div class="data-table" style="margin-bottom:15px; overflow-x: auto; display: none;" id="tableOfElementsViews">
                    <table class="xnat-table clean" id="sortableViewsTable">
                        <thead>
                            <tr>
                                <th style="width: 40px;"></th>
                                <th>&nbsp;</th>
                                <th>Element</th>
                                <th>Field ID</th>
                                <th>Header</th>
                                <th>Value</th>
                                <th>Order</th>
                            </tr>
                        </thead>
                        <tbody id="listOfFieldsViews">
                        </tbody>
                    </table>
                </div>
                <div style="display: none; margin-top: 15px;" id="newFieldContainerViews">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <span>Add field</span>
                        <select id="addFieldElementViews">
                            <option value="">(SELECT)</option>
                        </select>
                        <select id="addFieldIdViews">
                            <option value="">(SELECT)</option>
                        </select>
                        <input id="addFieldButtonViews" type="button" value="Add" class="btn btn-sm"/>
                        <div style="flex: 1;"></div>
                        <input id="saveFieldsButtonViews" type="button" value="Save" class="btn1 btn-sm" onclick="manager.update();" disabled style="opacity: 0.5; cursor: not-allowed;"/>
                    </div>
                </div>
            </div>

            <div id="xft-elements-tab">
                <div style="padding: 10px 0;">
                    <button type="button" onclick="loadXFTElements()" class="btn btn-sm">Load XFT Elements</button>
                    <label style="margin-left: 15px;">
                        <input type="checkbox" id="showMetaElements" onchange="loadXFTElements()" /> Show Metadata Elements
                    </label>
                    <label style="margin-left: 10px;">
                        <input type="checkbox" id="showHistoryElements" onchange="loadXFTElements()" /> Show History Elements
                    </label>
                    <p>This table displays all XFT element names registered in the system. By default, metadata and history elements are hidden.</p>
                </div>
                <div style="display: flex; gap: 10px; height: calc(100vh - 300px);">
                    <div style="flex: 0 0 400px; overflow-y: auto; border: 1px solid #ddd;">
                        <table id="xft-elements-table" class="xnat-table clean" style="margin: 0;">
                            <thead>
                            <tr>
                                <th>Element Name</th>
                            </tr>
                            </thead>
                            <tbody id="xftElementsTableBody">
                            </tbody>
                        </table>
                    </div>
                    <div id="element-details-panel" style="flex: 1; overflow-y: auto; border: 1px solid #ddd; padding: 15px; background-color: #f9f9f9;">
                        <div style="color: #999; text-align: center; padding: 40px;">
                            Select an element to view its details
                        </div>
                    </div>
                </div>
            </div>

            <div id="dynamic-datatypes-tab">
                <div style="padding: 10px 0;">
                    <button type="button" onclick="loadDynamicDataTypes()" class="btn btn-sm">Load Dynamic Data Types</button>
                    <p>This table displays all dynamic database-backed data types. Each schema can contain multiple custom data type elements.</p>
                </div>
                <div style="overflow-x: auto;">
                    <table id="dynamic-datatypes-table" class="xnat-table clean">
                        <thead>
                        <tr>
                            <th>Schema Name</th>
                            <th>Path</th>
                            <th>Elements</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody id="dynamicDatatypesTableBody">
                        </tbody>
                    </table>
                </div>
            </div>

            <div id="db-display-docs-tab">
                <div style="padding: 10px 0;">
                    <button type="button" onclick="loadDisplayDocs()" class="btn btn-sm">Load Display Docs</button>
                    <p>This table displays all database-backed element display configurations. Click an entry to view its details.</p>
                </div>
                <div style="display: flex; gap: 10px; height: calc(100vh - 300px);">
                    <div style="flex: 0 0 400px; overflow-y: auto; border: 1px solid #ddd;">
                        <table id="display-docs-table" class="xnat-table clean" style="margin: 0;">
                            <thead>
                            <tr>
                                <th class="sort">Element Name</th>
                                <th class="sort">Display Label</th>
                            </tr>
                            </thead>
                            <tbody id="displayDocsTableBody">
                            </tbody>
                        </table>
                    </div>
                    <div id="display-doc-details-panel" style="flex: 1; overflow-y: auto; border: 1px solid #ddd; padding: 15px; background-color: #f9f9f9;">
                        <div style="color: #999; text-align: center; padding: 40px;">
                            Select an element display to view its details
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div id="create-datatype-dialog" style="display:none;">
    <div style="background-color: #e8f4f8; border: 1px solid #b8d4e3; border-radius: 4px; padding: 10px 14px; margin-bottom: 15px;">
        <table style="width: 100%;">
            <tr>
                <td style="width: 130px; white-space: nowrap; font-weight: bold; padding: 3px 0;"><label>Element Name:</label></td>
                <td style="padding: 3px 0;"><span id="preview-element-name">--</span></td>
            </tr>
            <tr>
                <td style="white-space: nowrap; font-weight: bold; padding: 3px 0;"><label>Complex Type:</label></td>
                <td style="padding: 3px 0;"><span id="preview-complex-type">--</span></td>
            </tr>
        </table>
    </div>
    <div id="name-warning" class="warning" style="display: none; margin-bottom: 15px; font-size: 12px;">
        This name is very generic and may conflict with existing or future XNAT types. Consider making it more specific (e.g. add a project abbreviation or number).
    </div>
    <h3>Enter the details of the new data type to be created.</h3>
    <form id="create-datatype-form" class="panel">
        <div class="panel-element">
            <label class="element-label" for="extends">Extends</label>
            <div class="element-wrapper">
                <select id="datatype-extends" name="extends" required>
                    <option value="">(SELECT)</option>
                    <option value="subjectAssessorData">subjectAssessorData (Subject Assessment)</option>
                    <option value="imageAssessorData">imageAssessorData (Image Assessment)</option>
                    <option value="abstractProjectAsset">abstractProjectAsset (Project Asset)</option>
                </select>
            </div>
            <div class="clear"></div>
        </div>
        <div class="panel-element">
            <label class="element-label" for="name">Name</label>
            <div class="element-wrapper">
                <input type="text" id="datatype-name" name="name"
                   pattern="[A-Za-z0-9_]{2,24}"
                   minlength="2"
                   maxlength="24"
                   title="Only letters, numbers, and underscores allowed (2-24 characters)"
                   oninput="this.value = this.value.replace(/[^A-Za-z0-9_]/g, ''); updateDatatypePreview();"
                   required />
               <div class="description">Technical identifier used internally (2-24 characters, letters/numbers/underscores only)</div>
            </div>
            <div class="clear"></div>
        </div>
        <div class="panel-element">
            <label class="element-label" for="singular">Singular Name</label>
            <div class="element-wrapper">
                <input type="text" id="datatype-singular" name="singular"
                   pattern="[A-Za-z0-9_\s]{2,24}"
                   minlength="2"
                   maxlength="24"
                   title="Only letters, numbers, underscores, and spaces allowed (2-24 characters)"
                   oninput="this.value = this.value.replace(/[^A-Za-z0-9_\s]/g, '')"
                   required />
               <div class="description">Display name for one item (2-24 characters)</div>
            </div>
            <div class="clear"></div>
        </div>
        <div class="panel-element">
            <label class="element-label" for="plural">Plural Name</label>
            <div class="element-wrapper">
                <input type="text" id="datatype-plural" name="plural"
                   pattern="[A-Za-z0-9_\s]{2,24}"
                   minlength="2"
                   maxlength="24"
                   title="Only letters, numbers, underscores, and spaces allowed (2-24 characters)"
                   oninput="this.value = this.value.replace(/[^A-Za-z0-9_\s]/g, '')"
                   required />
               <div class="description">Display name for multiple items (2-24 characters)</div>
            </div>
            <div class="clear"></div>
        </div>
        <p>
            <a href="#" id="advanced-settings-toggle" onclick="toggleAdvancedSettings(); return false;" style="color: #666; text-decoration: none;">
                <span id="advanced-settings-icon">+</span> Advanced Settings
            </a>
        </p>
        <div id="advanced-settings-section" style="display: none; margin-top: 10px; background-color: #f5f5f5; padding: 10px;">
            <div class="panel-element">
                <label class="element-label" for="prefix">Prefix</label>
                <div class="element-wrapper">
                    <input type="text" id="datatype-prefix" name="prefix"
                       pattern="[A-Za-z0-9]{2,6}"
                       minlength="2"
                       maxlength="6"
                       title="Only letters and numbers allowed (2-6 characters)"
                       oninput="this.value = this.value.replace(/[^A-Za-z0-9]/g, ''); updateDatatypePreview();" />
                   <div class="description">Schema prefix (2-6 characters, letters/numbers only). Leave blank for auto-generation.</div>
                </div>
                <div class="clear"></div>
            </div>
            <div class="panel-element">
                <label class="element-label" for="complexType">Complex Type</label>
                <div class="element-wrapper">
                    <input type="text" id="datatype-complexType" name="complexType"
                       pattern="[A-Za-z0-9_]{4,24}"
                       minlength="4"
                       maxlength="24"
                       title="Only letters, numbers, and underscores allowed (4-24 characters)"
                       oninput="this.value = this.value.replace(/[^A-Za-z0-9_]/g, ''); updateDatatypePreview();" />
                   <div class="description">Complex type name (4-24 characters, letters/numbers/underscores). Leave blank for auto-generation.</div>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    </form>
</div>

<style>
    .progress-bar {
        width: 100%;
        height: 20px;
        background-color: #f0f0f0;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid #ccc;
    }
    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #4CAF50, #45a049);
        width: 0%;
        border-radius: 10px;
        animation: progress 2s ease-in-out infinite;
    }
    @keyframes progress {
        0% { width: 0%; }
        50% { width: 70%; }
        100% { width: 0%; }
    }

    /* Table grid lines */
    #data-type-table,
    #tableOfElements table,
    #tableOfElementsFields table,
    #tableOfElementsViews table,
    #xft-elements-table,
    #dynamic-datatypes-table,
    #display-docs-table {
        border-collapse: collapse;
    }

    #data-type-table th,
    #data-type-table td,
    #tableOfElements table th,
    #tableOfElements table td,
    #tableOfElementsFields table th,
    #tableOfElementsFields table td,
    #tableOfElementsViews table th,
    #tableOfElementsViews table td,
    #xft-elements-table th,
    #xft-elements-table td,
    #dynamic-datatypes-table th,
    #dynamic-datatypes-table td,
    #display-docs-table th,
    #display-docs-table td {
        border: 1px solid #ddd;
    }

    /* Element clickable links */
    .element-link {
        color: #0066cc;
        cursor: pointer;
        text-decoration: underline;
    }

    .element-link:hover {
        color: #003d7a;
    }

    /* Search Fields styles */
    div.content-wrapper {
        min-width: 300px;
        max-width: 100%;
        margin: 0 10px;
        position: relative;
        top: 0; bottom: 10px; left: 0; right: 0;
        font-family: Helvetica, Arial, sans-serif
    }

    .mono {
        font-family: Courier, monospace;
        font-size: 13px;
    }

    .dump {
        border-collapse: collapse;
    }

    .dump .info {
        padding-top: 15px;
        padding-bottom: 15px;
    }

    .dump thead {
        border-bottom: 1px solid #a0a0a0;
    }

    .dump th {
        padding: 8px;
        font-size: 14px;
    }

    .dump td {
        padding: 3px 8px;
        vertical-align: top;
    }

    .dump td.tag,
    .dump td.desc {
        white-space: nowrap;
    }

    .dump tbody tr:hover {
        background: #e5f2ff;
    }

    .dump .center {
        text-align: center;
    }

    .dump .left {
        text-align: left;
    }

    #preview-element-name,
    #preview-complex-type { font-family: monospace; color: #333; }
    #preview-element-name.error,
    #preview-complex-type.error { color: #c33; }
    #preview-element-name.error:after {
        background: #c33;
        content: "This element name is already in use";
        color: #fff;
        font-size: 9px;
        margin-left: 5px;
        padding: 0 4px;
        border-radius: 4px;
    }
    #preview-complex-type.error:after {
        background: #c33;
        content: "This complexType value is already in use";
        color: #fff;
        font-size: 9px;
        margin-left: 5px;
        padding: 0 4px;
        border-radius: 4px;
    }

    /* Drag and drop styles */
    #listOfFieldsViews tr {
        cursor: move;
        transition: background-color 0.2s;
    }

    #listOfFieldsViews tr:hover {
        background-color: #f0f0f0;
    }

    #listOfFieldsViews tr.dragging {
        opacity: 0.5;
        background-color: #e3f2fd;
    }

    #listOfFieldsViews tr.drag-over {
        border-top: 2px solid #2196F3;
    }

    .drag-handle {
        cursor: grab;
        text-align: center;
        user-select: none;
        padding: 8px;
        position: relative;
    }

    .drag-handle:active {
        cursor: grabbing;
    }

    .drag-handle::before {
        content: '';
        display: inline-block;
        width: 20px;
        height: 12px;
        background-image: linear-gradient(to bottom,
            transparent 0%, transparent 20%,
            #999 20%, #999 40%,
            transparent 40%, transparent 60%,
            #999 60%, #999 80%,
            transparent 80%, transparent 100%);
        background-size: 100% 100%;
        background-repeat: no-repeat;
    }

    /* View button styles */
    .view-button {
        margin-right: 8px;
        margin-bottom: 5px;
    }

    .view-button.active {
        background: #0D47A1;
        color: white;
        border-color: #0D47A1;
    }

    /* Element tree styles */
    .element-tree {
        font-family: monospace;
