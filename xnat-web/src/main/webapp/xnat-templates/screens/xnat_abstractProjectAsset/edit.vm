<script type="text/javascript" LANGUAGE="javascript" src="$content.getURI('scripts/subjectAssessorData/proj_tools.js')"></SCRIPT>
$page.setTitle("XDAT")
$page.setLinkColor($ui.alink)
$page.setVlinkColor($ui.vlink)

#set ($imageSessionType = $om.getImageSessionData().getXSIType())

#set($months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"])
#set($days = [ 1..31 ])
#set($years = [ $!turbineUtils.getYear()..1900])

#if ($data.message)
	<div class="alert">$data.message</div>
#end

<style>
    .snapshot-container {
        height: 200px;
        width: 200px;
    }
</style>
<form ID="form1" name="form1" method="post" action="$link.setAction("ModifyGenericData")">
<input type="hidden" name="project" value="$!{project}" >
<input type="hidden" name="$item.getXSIType()/ID" id="$item.getXSIType()/ID" value="$!om.getId()"/>
#if($vr)
	<div class="error">Invalid parameters:<BR>$vr.toHTML()</div>
    <HR>
#end

<table width="100%">
	<tr>
		<td>
			<table width="100%">
				<tr>
					<td align="left" valign="middle">
						#set($formName="$element.getSingularDescription()")
						<DIV class="edit_title">$formName</DIV>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr>
		<td>
			<table width="100%">
				<tr>
					<td valign="top">
						<table>
                            <tr>
                                <td>$displayManager.getSingularDisplayNameForProject()</td>
                                <td>
                                    <div id="project_placeholder">$!om.getProjectDisplayID()</div>
                                </td>
                                #if($!om.getPass() && $turbineUtils.canDelete($user, $om.getItem()))
                                    <td>
                                        <a onclick="modifyProject();"><i class="fa fa-edit" title="Edit Project"></i></a>
                                        <input type="hidden" id="$om.getXSIType()/project" name="$om.getXSIType()/project" value="$!om.getProject()"/>
                                        <script type="text/javascript">
                                            function modifyProject(){
                                                if(window.projectEditor==undefined){
                                                    var config =new Object();
                                                    if(window.currentID!=""){
                                                        config.uri=XNAT.app.current_uri;
                                                    }
                                                    window.projectEditor=new ProjectEditor(config);
                                                    window.projectEditor.onModification.subscribe(function (obj){
                                                        document.getElementById("project_placeholder").innerHTML=this.new_project_name;
                                                        document.getElementById("$om.getXSIType()/project").value=this.new_project;
                                                        XNAT.app.current_uri=serverRoot+"/REST/projects/" + this.new_project + "/subjects/$om.getImageSessionData().getSubjectId()/experiments/$om.getImageSessionData().getId()/assessors/$om.getId()";
                                                        config.uri=XNAT.app.current_uri;
                                                        confirmValues();
                                                    });
                                                    window.projectEditor.render();
                                                }
                                                window.projectEditor.panel.show();
                                            }
                                        </script>
                                    </td>
                                #end
                            </tr>
							<tr><td>Label</td>
								<td>#xdatStringBoxWClass("$item.getXSIType()/label" $item "" $vr "required")

								#xdatHiddenBox("$item.getXSIType()/project" $item $item.getStringProperty("$item.getXSIType()/project"))
								</td></tr>
							<tr><td>Date</td><td>#xdatDateBox("$item.getXSIType()/date" $item $vr $years)</td></tr>

						</table>
					</td>
				</tr>
			</table>
		</td>
	</tr>
	<tr>
	<td>
	    #parse("/screens/EditProjectSpecificFields.vm")
	</td>
	</tr>
	<tr>
		<td>

			<br>
			<hr>

			<div class="edit_header1">Additional Notes</div>

			<br>

			<table>
				<tr>
					#formLabel("Notes")
					<td>
						<textarea class='nullable' name="${om.getXSIType()}.note" rows="4" cols="50" style="text-align:left;">#escapeCleanHTML("$!item.getStringProperty('note')")</textarea>
					</td>
				</tr>
			</table>

			<br><br>
		</td>
	</tr>

	#if($item.getStringProperty("$item.getXSIType().ID"))
		#auditBoxes("3" "" "" "Modified $element.getSingularDescription()")
	#else
		#auditBoxes("3" "" "" "Created $element.getSingularDescription()")

	#end
	<tr>
		<td>
		#xdatEditProps($item $edit_screen)
		<input type="submit" name="eventSubmit_doInsert" value="Submit"/>
		</td>
	</tr>
</table>
</form>

<script type="text/javascript">
function validateForm()
{
   //INSERT CUSTOM CONTENT HERE

   validateExperimentForm();
   return false;
}
</script>
