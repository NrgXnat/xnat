<!-- BEGIN /xnat-templates/screens/xnat_respSessionData/upload/xnat_respSessionData_fields.vm -->

<tr valign="top">
    <th align="left"><p style="margin-top: 0.5em">Scanner Name</p></th>

	#set($currentScanner=$item.getProperty("scanner"))
	#set($scanners = $data.getSession().getAttribute("userHelper").getQueryResultsAsArrayList("SELECT DISTINCT isd.scanner  FROM xnat_imageSessionData isd LEFT JOIN xnat_experimentData expt ON isd.id=expt.id LEFT JOIN xdat_meta_element xme ON expt.extension=xme.xdat_meta_element_id LEFT JOIN xnat_imagescandata scan ON isd.id=scan.image_session_id WHERE xme.element_name='${datatype}' AND scan.scanner='$currentScanner'"))

	#if($scanners.size()==0)
		#if($project)
			#set($scanners = $data.getSession().getAttribute("userHelper").getQueryResultsAsArrayList("SELECT DISTINCT isd.scanner  FROM xnat_essessiondata mr LEFT JOIN xnat_imageSessionData isd ON mr.id=isd.id LEFT JOIN xnat_experimentData expt ON isd.id=expt.id WHERE expt.project='$project'"))
			#if($scanners.size()==0)
				#set($scanners = $data.getSession().getAttribute("userHelper").getQueryResultsAsArrayList("SELECT DISTINCT isd.scanner  FROM xnat_essessiondata mr LEFT JOIN xnat_imageSessionData isd ON mr.id=isd.id"))
			#end
		#else
			#set($scanners = $data.getSession().getAttribute("userHelper").getQueryResultsAsArrayList("SELECT DISTINCT isd.scanner  FROM xnat_essessiondata mr LEFT JOIN xnat_imageSessionData isd ON mr.id=isd.id"))
		#end
	#end

	#if($scanners.size()==0)
		<td> #xdatTextBox("${datatype}.scanner" $item "" $vr)</td>
	#else
		<td>

			#if (!$datatype)
				#set ($datatype = 'xnat:respSessionData')
			#end
			#parse('/screens/xnat_imageSessionData/upload/scanners.vm')

		</td>
	#end
</tr>

<tr>
	<th>Acquisition Site</th>
	<td>
	 #xdatTextBox("${datatype}.acquisition_site" $item "" $vr)
	</td>
	<td></td>
</tr>

<!-- END /xnat-templates/screens/xnat_respSessionData/upload/xnat_respSessionData_fields.vm -->
